module

public import Reisner.Cech.DegreeZero

@[expose] public section

/-!
# Cofinal generator-power stages for the Ext/Čech comparison

In every cohomological degree, augmentation-supported Ext-colimit local
cohomology can be computed using quotients by powers of the individual
variables. This is a cofinality result, not yet a comparison with Čech
cohomology. No Noetherian or nontrivial-coefficient hypothesis is needed.
-/

open CategoryTheory Limits Opposite

universe u v

namespace Reisner.Complex

variable {V : Type u} (K : Reisner.Complex V) (R : Type v) [CommRing R]

/-- The ideal generated by the `n`-th powers of all ambient variable classes.
When there are no vertices this is `⊥`, including at `n = 0`. -/
noncomputable def faceRingGeneratorPowerIdeal (n : ℕ) : Ideal (K.FaceRing R) :=
  Ideal.span (Set.range fun w : V =>
    (Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X w)) ^ n)

/-- The generator-power ideal at stage one is the augmentation ideal. -/
@[simp] theorem faceRingGeneratorPowerIdeal_one :
    K.faceRingGeneratorPowerIdeal R 1 = K.faceRingAugmentationIdeal R := by
  simp [faceRingGeneratorPowerIdeal, faceRingAugmentationIdeal]

/-- Taking powers of individual variables produces a subideal of the
corresponding power of the augmentation ideal, also at exponent zero. -/
theorem faceRingGeneratorPowerIdeal_le_pow (n : ℕ) :
    K.faceRingGeneratorPowerIdeal R n ≤ K.faceRingAugmentationIdeal R ^ n := by
  apply Ideal.span_le.mpr
  rintro _ ⟨w, rfl⟩
  have hw : Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X w) ∈
      K.faceRingAugmentationIdeal R := Ideal.subset_span ⟨w, rfl⟩
  exact Ideal.pow_mem_pow hw n

/-- An explicit converse bound. The extra one keeps the statement valid for
the empty vertex set at exponent zero. -/
theorem faceRingAugmentationIdeal_pow_le_generatorPowerIdeal [Fintype V] (n : ℕ) :
    K.faceRingAugmentationIdeal R ^ (Fintype.card V * n + 1) ≤
      K.faceRingGeneratorPowerIdeal R n := by
  classical
  let f (w : V) := Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X w)
  have h := Reisner.span_finset_pow_le_of_generator_powers_mem
    (Finset.univ : Finset V) f (fun _ => n) (K.faceRingGeneratorPowerIdeal R n)
    (fun w _ => Ideal.subset_span ⟨w, rfl⟩)
  simpa [f, Finset.coe_univ, Set.image_univ, faceRingAugmentationIdeal] using h

/-- The generator-power stages are decreasing. -/
theorem faceRingGeneratorPowerIdeal_antitone :
    Antitone (K.faceRingGeneratorPowerIdeal R) := by
  intro n m hnm
  apply Ideal.span_le.mpr
  rintro _ ⟨w, rfl⟩
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hnm
  dsimp only
  rw [pow_add]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨w, rfl⟩)

/-- The contravariant sequence of ideals generated by individual powers. -/
noncomputable def faceRingGeneratorPowersDiagram : ℕᵒᵖ ⥤ Ideal (K.FaceRing R) where
  obj n := K.faceRingGeneratorPowerIdeal R n.unop
  map f := homOfLE (K.faceRingGeneratorPowerIdeal_antitone R f.unop.down.down)

/-- Each generator-power stage has radical containing the augmentation ideal. -/
theorem faceRingAugmentationIdeal_le_generatorPowerIdeal_radical (n : ℕ) :
    K.faceRingAugmentationIdeal R ≤ (K.faceRingGeneratorPowerIdeal R n).radical := by
  apply Ideal.span_le.mpr
  rintro _ ⟨w, rfl⟩
  exact ⟨n, Ideal.subset_span ⟨w, rfl⟩⟩

/-- Generator-power ideals, viewed in the category of ideals whose radical
contains the augmentation ideal. -/
noncomputable def faceRingGeneratorPowersToSelfLERadical :
    ℕᵒᵖ ⥤ localCohomology.SelfLERadical (K.faceRingAugmentationIdeal R) :=
  ObjectProperty.lift _ (K.faceRingGeneratorPowersDiagram R) fun n =>
    K.faceRingAugmentationIdeal_le_generatorPowerIdeal_radical R n.unop

variable [Fintype V]

/-- The augmentation ideal is finitely generated even when the coefficient
ring is not Noetherian. -/
theorem faceRingAugmentationIdeal_fg : (K.faceRingAugmentationIdeal R).FG := by
  exact Submodule.fg_span (Set.finite_range _)

/-- Augmentation-ideal powers are initial among ideals whose radical contains
the augmentation ideal. Only finite generation of that ideal is used. -/
theorem faceRingAugmentationPowers_initial :
    Functor.Initial
      (localCohomology.idealPowersToSelfLERadical (K.faceRingAugmentationIdeal R)) where
  out J := by
    apply +allowSynthFailures zigzag_isConnected
    · obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg J.2
        (K.faceRingAugmentationIdeal_fg R)
      exact ⟨CostructuredArrow.mk (⟨⟨⟨hn⟩⟩⟩ :
        (localCohomology.idealPowersToSelfLERadical
          (K.faceRingAugmentationIdeal R)).obj (op n) ⟶ J)⟩
    · intro j₁ j₂
      apply Relation.ReflTransGen.single
      rcases le_total j₁.left.unop j₂.left.unop with h | h
      · right; exact ⟨CostructuredArrow.homMk (homOfLE h).op rfl⟩
      · left; exact ⟨CostructuredArrow.homMk (homOfLE h).op rfl⟩

/-- Individual-variable powers are also initial among ideals supported at
the augmentation ideal, including an empty ambient vertex set. -/
theorem faceRingGeneratorPowers_initial :
    Functor.Initial (K.faceRingGeneratorPowersToSelfLERadical R) where
  out J := by
    apply +allowSynthFailures zigzag_isConnected
    · obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg J.2
        (K.faceRingAugmentationIdeal_fg R)
      exact ⟨CostructuredArrow.mk (⟨⟨⟨
        (K.faceRingGeneratorPowerIdeal_le_pow R n).trans hn⟩⟩⟩ :
        (K.faceRingGeneratorPowersToSelfLERadical R).obj (op n) ⟶ J)⟩
    · intro j₁ j₂
      apply Relation.ReflTransGen.single
      rcases le_total j₁.left.unop j₂.left.unop with h | h
      · right; exact ⟨CostructuredArrow.homMk (homOfLE h).op rfl⟩
      · left; exact ⟨CostructuredArrow.homMk (homOfLE h).op rfl⟩

/-- Derived Ext with coefficient module the face ring, indexed by all ideals
whose radical contains the augmentation ideal. -/
noncomputable def faceRingSupportedExtDiagram (q : ℕ) :
    (localCohomology.SelfLERadical (K.faceRingAugmentationIdeal R))ᵒᵖ ⥤
      ModuleCat.{max u v} (K.FaceRing R) :=
  (localCohomology.ringModIdeals
      (localCohomology.selfLERadicalDiagram (K.faceRingAugmentationIdeal R))).op ⋙
    CategoryTheory.Abelian.linearExtFunctor (K.FaceRing R)
      (ModuleCat.{max u v} (K.FaceRing R)) q ⋙
    (evaluation _ _).obj (ModuleCat.of (K.FaceRing R) (K.FaceRing R))

/-- The actual derived Ext diagram with stages
`Ext^q(A / (x_v^n : v ∈ V), A)`. The index `n` is a power exponent and
`q` is the cohomological degree, with no degree shift. -/
noncomputable def faceRingGeneratorPowerExtDiagram (q : ℕ) :
    (ℕᵒᵖ)ᵒᵖ ⥤ ModuleCat.{max u v} (K.FaceRing R) :=
  (localCohomology.ringModIdeals (K.faceRingGeneratorPowersDiagram R)).op ⋙
    CategoryTheory.Abelian.linearExtFunctor (K.FaceRing R)
      (ModuleCat.{max u v} (K.FaceRing R)) q ⋙
    (evaluation _ _).obj (ModuleCat.of (K.FaceRing R) (K.FaceRing R))

/-- The augmentation-powers Ext diagram is the restriction of the supported
diagram along the augmentation-powers functor. -/
noncomputable def faceRingAugmentationPowerExtDiagramIso (q : ℕ) :
    (localCohomology.idealPowersToSelfLERadical
      (K.faceRingAugmentationIdeal R)).op ⋙ K.faceRingSupportedExtDiagram R q ≅
      Reisner.depthExtLocalCohomologyModuleDiagram (K.faceRingAugmentationIdeal R) q
        (ModuleCat.of (K.FaceRing R) (K.FaceRing R)) :=
  Iso.refl _

/-- The generator-power Ext diagram is the restriction of the supported
diagram along the generator-powers functor. -/
noncomputable def faceRingGeneratorPowerExtDiagramIso (q : ℕ) :
    (K.faceRingGeneratorPowersToSelfLERadical R).op ⋙ K.faceRingSupportedExtDiagram R q ≅
      K.faceRingGeneratorPowerExtDiagram R q :=
  Iso.refl _

/-- In every cohomological degree, augmentation-supported local cohomology
of the face ring is the colimit of Ext from the generator-power quotients.
This normalizes the stages; it does not yet compare them with Čech cohomology.
The isomorphism is linear over the face ring itself. -/
noncomputable def faceRingLocalCohomologyIsoGeneratorPowerExtColimit (q : ℕ) :
    (Reisner.depthExtLocalCohomology (K.faceRingAugmentationIdeal R) q).obj
        (ModuleCat.of (K.FaceRing R) (K.FaceRing R)) ≅
      colimit (K.faceRingGeneratorPowerExtDiagram R q) := by
  letI := K.faceRingAugmentationPowers_initial R
  letI := K.faceRingGeneratorPowers_initial R
  exact
    (colimitObjIsoColimitCompEvaluation
      (Reisner.depthExtLocalCohomologyDiagram (K.faceRingAugmentationIdeal R) q)
      (ModuleCat.of (K.FaceRing R) (K.FaceRing R))) ≪≫
    HasColimit.isoOfNatIso (faceRingAugmentationPowerExtDiagramIso K R q).symm ≪≫
    Functor.Final.colimitIso
      (localCohomology.idealPowersToSelfLERadical (K.faceRingAugmentationIdeal R)).op
      (K.faceRingSupportedExtDiagram R q) ≪≫
    (Functor.Final.colimitIso (K.faceRingGeneratorPowersToSelfLERadical R).op
      (K.faceRingSupportedExtDiagram R q)).symm ≪≫
    HasColimit.isoOfNatIso (faceRingGeneratorPowerExtDiagramIso K R q)

end Reisner.Complex
