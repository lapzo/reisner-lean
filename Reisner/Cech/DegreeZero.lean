module

public import Reisner.Cech.Core
public import Reisner.LocalCohomology
public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings

@[expose] public section

/-!
# Degree-zero cohomology of the extended Čech complex

The degree-zero term of the extended Čech complex is the face ring. Its
outgoing differential has one coordinate for each singleton localization.
The common kernel of these localizations identifies the degree-zero cycles
with the degree-zero Ext-colimit module supported at the augmentation ideal.
The incoming differential at zero vanishes, so taking the class of a cycle
gives an equivalence with the degree-zero cohomology object.
-/

namespace Reisner.Complex

universe u v

variable {V : Type u} (K : Reisner.Complex V) (R : Type v) [CommRing R]

/-- The degree-zero Čech cochains are naturally the face ring. -/
noncomputable def cechZeroFromFaceRing [Fintype V] :
    K.FaceRing R →ₗ[R] K.CechCochain R 0 :=
  LinearMap.pi fun F =>
    (K.faceRingLocalizationMap R (Finset.empty_subset F.1)).toLinearMap.comp
      (K.faceRingLocalizationEmptyEquiv R).toLinearMap

theorem cechZeroFromFaceRing_bijective [Fintype V] :
    Function.Bijective (K.cechZeroFromFaceRing R) := by
  classical
  letI : Unique (CechIndex V 0) := {
    default := ⟨∅, by simp⟩
    uniq := fun x => Subtype.ext (Finset.card_eq_zero.mp x.2)
  }
  constructor
  · intro x y h
    have he : (K.faceRingLocalizationEmptyEquiv R) x =
        (K.faceRingLocalizationEmptyEquiv R) y := by
      simpa [cechZeroFromFaceRing, faceRingLocalizationMap_self] using congrFun h default
    exact (K.faceRingLocalizationEmptyEquiv R).injective he
  · intro z
    refine ⟨(K.faceRingLocalizationEmptyEquiv R).symm (z default), ?_⟩
    ext F
    have hF : F = default := Subsingleton.elim _ _
    subst F
    simp [cechZeroFromFaceRing, faceRingLocalizationMap_self]

/-- An explicit linear equivalence from the face ring to degree-zero Čech cochains. -/
noncomputable def cechZeroFaceRingEquiv [Fintype V] :
    K.FaceRing R ≃ₗ[R] K.CechCochain R 0 :=
  LinearEquiv.ofBijective (K.cechZeroFromFaceRing R) (K.cechZeroFromFaceRing_bijective R)

variable [Fintype V] [LinearOrder V]

/-- The product over a singleton is its vertex class. -/
@[simp] theorem faceRingFaceProduct_singleton (w : V) :
    K.faceRingFaceProduct R {w} =
      Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X w) := by
  simp [faceRingFaceProduct]

/-- The ideal generated by the singleton products is the augmentation ideal. -/
theorem faceRingVertexGenerator_span_eq_augmentationIdeal :
    Ideal.span (Set.range (fun w : V => K.faceRingFaceProduct R {w})) =
      K.faceRingAugmentationIdeal R := by
  change Ideal.span (Set.range (fun w : V => K.faceRingFaceProduct R {w})) =
    Ideal.span (Set.range fun w : V =>
      Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X w))
  congr 1
  ext a
  constructor
  · rintro ⟨w, rfl⟩
    exact ⟨w, by simp⟩
  · rintro ⟨w, rfl⟩
    exact ⟨w, by simp⟩

/-- Vanishing in the singleton Away localization is equivalent to being
killed by a power of its vertex product. -/
theorem faceRingAwayMap_eq_zero_iff_torsion (x : K.FaceRing R) (w : V) :
    algebraMap (K.FaceRing R) (K.FaceRingLocalization R {w}) x = 0 ↔
      ∃ n : ℕ, (K.faceRingFaceProduct R {w}) ^ n • x = 0 := by
  rw [IsLocalization.map_eq_zero_iff (Submonoid.powers (K.faceRingFaceProduct R {w}))]
  constructor
  · rintro ⟨s, hs⟩
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
    refine ⟨n, ?_⟩
    have hs' : x * (K.faceRingFaceProduct R {w}) ^ n = 0 := by
      calc
        x * (K.faceRingFaceProduct R {w}) ^ n =
            (K.faceRingFaceProduct R {w}) ^ n * x := mul_comm _ _
        _ = (s : K.FaceRing R) * x := by rw [hn]
        _ = 0 := hs
    simpa [Algebra.smul_def, mul_comm] using hs'
  · rintro ⟨n, hn⟩
    refine ⟨⟨(K.faceRingFaceProduct R {w}) ^ n,
      (Submonoid.mem_powers_iff _ _).mpr ⟨n, rfl⟩⟩, ?_⟩
    simpa [Algebra.smul_def, mul_comm] using hn

/-- On a singleton coordinate, the degree-zero differential is the ordinary
localization map from the face ring. -/
theorem cechDifferential_zero_apply (x : K.FaceRing R) (w : V) :
    K.cechDifferential R 0 (K.cechZeroFromFaceRing R x) ⟨{w}, by simp⟩ =
      algebraMap (K.FaceRing R) (K.FaceRingLocalization R {w}) x := by
  rw [cechDifferential_apply]
  simp [cechZeroFromFaceRing, Finset.filter_singleton,
    faceRingLocalizationEmptyEquiv_apply, faceRingLocalizationMap_algebraMap]

/-- A degree-zero Čech cochain is a cocycle exactly when its face-ring element
maps to zero in every singleton localization. -/
theorem cechDifferential_zero_eq_zero_iff (x : K.FaceRing R) :
    K.cechDifferential R 0 (K.cechZeroFromFaceRing R x) = 0 ↔
      ∀ w : V, algebraMap (K.FaceRing R) (K.FaceRingLocalization R {w}) x = 0 := by
  constructor
  · intro h w
    have hw := congrFun h ⟨{w}, by simp⟩
    rw [K.cechDifferential_zero_apply R x w] at hw
    exact hw
  · intro h
    ext G
    obtain ⟨w, hw⟩ := Finset.card_eq_one.mp G.2
    have hG : G = ⟨{w}, by simp⟩ := Subtype.ext hw
    rw [hG, K.cechDifferential_zero_apply R x w]
    exact h w

/-- The intersection of kernels of localization at each singleton variable. -/
noncomputable def cechSingletonLocalizationLinearMap (w : V) :
    K.FaceRing R →ₗ[R] K.FaceRingLocalization R {w} :=
  (Algebra.algHom R (K.FaceRing R) (K.FaceRingLocalization R {w})).toLinearMap

noncomputable def cechZeroLocalizationKernel : Submodule R (K.FaceRing R) :=
  ⨅ w : V, LinearMap.ker (K.cechSingletonLocalizationLinearMap R w)

theorem mem_cechZeroLocalizationKernel_iff (x : K.FaceRing R) :
    x ∈ K.cechZeroLocalizationKernel R ↔
      ∀ w : V, algebraMap (K.FaceRing R) (K.FaceRingLocalization R {w}) x = 0 := by
  rw [cechZeroLocalizationKernel, Submodule.mem_iInf]
  simp only [LinearMap.mem_ker]
  change (∀ w : V,
      (Algebra.algHom R (K.FaceRing R) (K.FaceRingLocalization R {w})).toLinearMap x = 0) ↔ _
  constructor
  · intro h w
    have hw := h w
    change (IsScalarTower.toAlgHom R (K.FaceRing R)
      (K.FaceRingLocalization R {w})) x = 0 at hw
    rw [IsScalarTower.toAlgHom_apply] at hw
    exact hw
  · intro h w
    have hw := h w
    change (IsScalarTower.toAlgHom R (K.FaceRing R)
      (K.FaceRingLocalization R {w})) x = 0
    rw [IsScalarTower.toAlgHom_apply]
    exact hw

/-- The intersection of the singleton Away-localization kernels agrees with
the corresponding intersection for module localization at powers. -/
theorem cechZeroLocalizationKernel_eq_restrictedPowerKernel :
    K.cechZeroLocalizationKernel R =
      Submodule.restrictScalars R
        (Reisner.finiteLocalizationKernel (R := K.FaceRing R) (M := K.FaceRing R)
          (ι := V) (Finset.univ : Finset V) (fun w => K.faceRingFaceProduct R {w})) := by
  classical
  ext x
  rw [cechZeroLocalizationKernel, Submodule.mem_iInf]
  rw [Submodule.restrictScalars_mem]
  rw [Reisner.finiteLocalizationKernel, Submodule.mem_iInf]
  change (∀ w : V, x ∈ LinearMap.ker (K.cechSingletonLocalizationLinearMap R w)) ↔
    (∀ w : {w : V // w ∈ Finset.univ}, x ∈ LinearMap.ker
      (LocalizedModule.mkLinearMap
        (Submonoid.powers (K.faceRingFaceProduct R {w.1})) (K.FaceRing R)))
  simp only [LinearMap.mem_ker]
  constructor
  · intro h i
    have hz : algebraMap (K.FaceRing R) (K.FaceRingLocalization R {i.1}) x = 0 := h i.1
    have ht := (K.faceRingAwayMap_eq_zero_iff_torsion R x i.1).mp hz
    exact (Reisner.principalLocalization_kernel_iff_torsion
      (K.faceRingFaceProduct R {i.1}) x).mpr ht
  · intro h w
    have hp := h ⟨w, Finset.mem_univ _⟩
    have ht := (Reisner.principalLocalization_kernel_iff_torsion
      (K.faceRingFaceProduct R {w}) x).mp hp
    exact (K.faceRingAwayMap_eq_zero_iff_torsion R x w).mpr ht

/-- Transporting the degree-zero cycle kernel along the degree-zero term
equivalence gives precisely the simultaneous localization kernel. -/
theorem cechZeroLocalizationKernel_eq_cycleComap :
    K.cechZeroLocalizationKernel R =
      Submodule.comap (K.cechZeroFromFaceRing R)
        (LinearMap.ker (K.cechDifferential R 0)) := by
  ext x
  rw [K.mem_cechZeroLocalizationKernel_iff R x]
  rw [Submodule.mem_comap, LinearMap.mem_ker]
  exact (K.cechDifferential_zero_eq_zero_iff R x).symm

/-- Degree-zero Čech cycles are linearly equivalent to the simultaneous
localization kernel in the face ring. -/
noncomputable def cechZeroCyclesLocalizationEquiv :
    K.cechZeroLocalizationKernel R ≃ₗ[R]
      LinearMap.ker (K.cechDifferential R 0) := by
  let e := K.cechZeroFaceRingEquiv R
  refine {
    toFun := fun x => ⟨e x.1, by
      change K.cechDifferential R 0 (K.cechZeroFromFaceRing R x.1) = 0
      have hx : x.1 ∈ Submodule.comap (K.cechZeroFromFaceRing R)
          (LinearMap.ker (K.cechDifferential R 0)) := by
        rw [← K.cechZeroLocalizationKernel_eq_cycleComap R]
        exact x.2
      exact Submodule.mem_comap.mp hx⟩
    invFun := fun y => ⟨e.symm y.1, by
      apply (K.mem_cechZeroLocalizationKernel_iff R (e.symm y.1)).2
      have hy : K.cechZeroFromFaceRing R (e.symm y.1) = y.1 := by
        change e (e.symm y.1) = y.1
        exact e.apply_symm_apply y.1
      have hzero : K.cechDifferential R 0
          (K.cechZeroFromFaceRing R (e.symm y.1)) = 0 := by
        rw [hy]
        exact y.2
      exact (K.cechDifferential_zero_eq_zero_iff R (e.symm y.1)).mp hzero⟩
    map_add' := by
      intro x y
      apply Subtype.ext
      simp [e]
    map_smul' := by
      intro r x
      apply Subtype.ext
      simp [e]
    left_inv := by
      intro x
      apply Subtype.ext
      change e.symm (e x.1) = x.1
      exact e.symm_apply_apply x.1
    right_inv := by
      intro y
      apply Subtype.ext
      change e (e.symm y.1) = y.1
      exact e.apply_symm_apply y.1 }

/-- Degree-zero Ext-colimit local cohomology of the face ring, with support in the
augmentation ideal and scalars restricted to `R`, is equivalent to the degree-zero
cycles of the extended Čech complex. -/
noncomputable def extZeroCechCyclesEquiv :
    (ModuleCat.restrictScalars (algebraMap R (K.FaceRing R))).obj
      ((Reisner.depthExtLocalCohomology (K.faceRingAugmentationIdeal R) 0).obj
        (ModuleCat.of (K.FaceRing R) (K.FaceRing R))) ≃ₗ[R]
      LinearMap.ker (K.cechDifferential R 0) := by
  let f (w : V) := K.faceRingFaceProduct R {w}
  have hI : Ideal.span (f '' (Finset.univ : Finset V)) = K.faceRingAugmentationIdeal R := by
    simpa only [Finset.coe_univ, Set.image_univ] using
      K.faceRingVertexGenerator_span_eq_augmentationIdeal R
  rw [← hI]
  let extModule := (Reisner.depthExtLocalCohomology (Ideal.span (f '' (Finset.univ : Finset V))) 0).obj
    (ModuleCat.of (K.FaceRing R) (K.FaceRing R))
  let restrictedExt := (ModuleCat.restrictScalars (algebraMap R (K.FaceRing R))).obj extModule
  letI : IsScalarTower R (K.FaceRing R) restrictedExt :=
    IsScalarTower.of_compHom R (K.FaceRing R) extModule
  let powerKernel := Reisner.finiteLocalizationKernel (M := K.FaceRing R) Finset.univ f
  let e : restrictedExt ≃ₗ[K.FaceRing R] powerKernel.restrictScalars R :=
    Reisner.finiteGeneratorsExtZeroLocalizationKernelEquiv Finset.univ f
      (ModuleCat.of (K.FaceRing R) (K.FaceRing R))
  exact (e.restrictScalars R).trans <|
    (LinearEquiv.ofEq _ _ (K.cechZeroLocalizationKernel_eq_restrictedPowerKernel R).symm).trans
      (K.cechZeroCyclesLocalizationEquiv R)

open CategoryTheory in
/-- Taking the cohomology class of a degree-zero Čech cycle is an equivalence:
the natural-number cochain shape has zero incoming differential at degree zero. -/
noncomputable def cechZeroCyclesHomologyEquiv :
    LinearMap.ker (K.cechDifferential R 0) ≃ₗ[R] (K.cechComplex R).homology 0 := by
  let C := K.cechComplex R
  let d := ModuleCat.ofHom (K.cechDifferential R 0)
  let e := (ModuleCat.kernelIsLimit d).conePointUniqueUpToIso (C.cyclesIsKernel 0 1 (by simp))
  have hin : C.d 0 0 = 0 := C.shape 0 0 (by simp [ComplexShape.up_Rel])
  exact (e ≪≫ C.isoHomologyπ 0 0 (by simp) hin).toLinearEquiv

/-- Degree-zero Ext-colimit local cohomology of the face ring at its augmentation
ideal, restricted to the coefficient ring, is the degree-zero Čech cohomology module. -/
noncomputable def extZeroCechCohomologyEquiv :
    (ModuleCat.restrictScalars (algebraMap R (K.FaceRing R))).obj
      ((Reisner.depthExtLocalCohomology (K.faceRingAugmentationIdeal R) 0).obj
        (ModuleCat.of (K.FaceRing R) (K.FaceRing R))) ≃ₗ[R]
      (K.cechComplex R).homology 0 :=
  (K.extZeroCechCyclesEquiv R).trans (K.cechZeroCyclesHomologyEquiv R)

end Reisner.Complex
