/-!
# The Stanley–Reisner ideal and standard monomial basis

Complexes include the empty face and may have ghost ambient vertices.
The ideal is generated by squarefree nonface monomials. Its membership
characterization is a theorem, not its definition.

Blueprint nodes: `def:complex`, `def:ring`, `lem:indicator`, `thm:membership`,
`prop:basis`, `lem:homogeneous`, `prop:grading`, `prop:augmentation`,
`prop:facet-primes`, `def:dimension`, `prop:dimension`, and
`lem:localization-kernel`, and `lem:localized`. The quotient has checked fine and total gradings,
augmentation foundations, coordinate-prime/facet results, and global and
augmentation-local Krull dimension. Actual localizations at variable
products have checked kernels, fraction criteria, and transition maps.
Their integer grading has an explicit Laurent monomial basis. Finite-type and facet
results state their finite-ambient hypotheses explicitly.
Polynomial membership works over commutative semirings; the quotient basis
works over commutative rings, in particular any field.
-/

@[expose] public section

namespace Reisner

universe u v

/-- A downward closed family of finite faces, containing the empty face.
The ambient type can contain vertices whose singleton is not a face. -/
structure Complex (V : Type u) where
  faces : LowerSet (Finset V)
  empty_mem : ∅ ∈ faces

namespace Complex

variable {V : Type u} (K : Complex V)

/-- Downward closure, in the subset notation used for finite faces. -/
theorem face_of_subset {F G : Finset V} (hFG : F ⊆ G) (hG : G ∈ K.faces) :
    F ∈ K.faces :=
  K.faces.lower hFG hG

/-- A nonface remains a nonface on enlarging its finite vertex set. -/
theorem nonface_of_subset {F G : Finset V} (hFG : F ⊆ G) (hF : F ∉ K.faces) :
    G ∉ K.faces :=
  fun hG => hF (K.face_of_subset hFG hG)

end Complex

variable {V : Type u}

/-- The squarefree exponent vector of a finite set of ambient vertices. -/
noncomputable def squarefreeExponent (F : Finset V) : V →₀ ℕ :=
  Finsupp.indicator F (fun _ _ => 1)

@[simp]
theorem squarefreeExponent_apply [DecidableEq V] (F : Finset V) (v : V) :
    squarefreeExponent F v = if v ∈ F then 1 else 0 := by
  classical
  simp [squarefreeExponent, Finsupp.indicator_apply]

@[simp]
theorem support_squarefreeExponent (F : Finset V) :
    (squarefreeExponent F).support = F := by
  classical
  ext v
  simp [Finsupp.mem_support_iff]

/-- A squarefree monomial divides a monic monomial precisely when its
vertices occur in the latter's exponent support. -/
theorem squarefreeExponent_le_iff (F : Finset V) (α : V →₀ ℕ) :
    squarefreeExponent F ≤ α ↔ F ⊆ α.support := by
  classical
  constructor
  · intro h v hv
    have hv' : 1 ≤ α v := by simpa [hv] using h v
    exact Finsupp.mem_support_iff.mpr (Nat.one_le_iff_ne_zero.mp hv')
  · intro h v
    by_cases hv : v ∈ F
    · simpa [hv] using Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp (h hv))
    · simp [hv]

/-- The indicator exponent gives the usual product of distinct variables. -/
theorem monomial_squarefreeExponent_eq_prod (k : Type v) [CommSemiring k]
    (F : Finset V) :
    MvPolynomial.monomial (squarefreeExponent F) (1 : k) =
      ∏ v ∈ F, MvPolynomial.X v := by
  classical
  simpa [squarefreeExponent] using
    (MvPolynomial.prod_X_pow (R := k) (fun _ : V => 1) F).symm

namespace Complex

variable (K : Complex V) (k : Type v) [CommSemiring k]

/-- Exponents of the squarefree monomials indexed by nonfaces. -/
noncomputable def nonfaceExponents : Set (V →₀ ℕ) :=
  squarefreeExponent '' {F : Finset V | F ∉ K.faces}

/-- The Stanley–Reisner ideal, defined from squarefree nonface generators. -/
noncomputable def stanleyReisnerIdeal : Ideal (MvPolynomial V k) :=
  Ideal.span ((fun α => MvPolynomial.monomial α (1 : k)) '' K.nonfaceExponents)

/-- The Stanley–Reisner ideal is homogeneous for every weighted grading of
the polynomial ring, including weights that vanish. -/
theorem stanleyReisnerIdeal_isHomogeneous (R : Type v) [CommSemiring R]
    {M : Type*} [AddCommMonoid M] (w : V → M) :
    letI : DecidableEq M := Classical.decEq M
    letI := MvPolynomial.weightedGradedAlgebra R w
    (K.stanleyReisnerIdeal R).IsHomogeneous
      (MvPolynomial.weightedHomogeneousSubmodule R w) := by
  classical
  let _ : DecidableEq M := Classical.decEq M
  let _ := MvPolynomial.weightedGradedAlgebra R w
  rw [stanleyReisnerIdeal, nonfaceExponents]
  apply Ideal.homogeneous_span
  rintro p ⟨α, hα, rfl⟩
  exact ⟨Finsupp.weight w α,
    MvPolynomial.isWeightedHomogeneous_monomial w α (1 : R) rfl⟩

/-- Every weighted homogeneous component of a polynomial in the
Stanley–Reisner ideal remains in the ideal. -/
theorem weightedHomogeneousComponent_mem_stanleyReisnerIdeal
    (R : Type v) [CommSemiring R] {M : Type*} [AddCommMonoid M]
    (w : V → M) {p : MvPolynomial V R} (hp : p ∈ K.stanleyReisnerIdeal R)
    (d : M) :
    MvPolynomial.weightedHomogeneousComponent w d p ∈ K.stanleyReisnerIdeal R := by
  classical
  let _ : DecidableEq M := Classical.decEq M
  let _ := MvPolynomial.weightedGradedAlgebra R w
  exact MvPolynomial.weightedHomogeneousComponent_mem_of_mem R w
    (K.stanleyReisnerIdeal_isHomogeneous R w) hp d

/-- An equivalent presentation using products of distinct variables. -/
theorem stanleyReisnerIdeal_eq_span :
    K.stanleyReisnerIdeal k = Ideal.span
      ((fun F : Finset V => ∏ v ∈ F, (MvPolynomial.X v : MvPolynomial V k)) ''
        {F : Finset V | F ∉ K.faces}) := by
  simp only [stanleyReisnerIdeal, nonfaceExponents, Set.image_image,
    monomial_squarefreeExponent_eq_prod]

/-- A polynomial is in the Stanley–Reisner ideal iff every exponent in its
polynomial support has nonface vertex support. -/
theorem mem_stanleyReisnerIdeal_iff (f : MvPolynomial V k) :
    f ∈ K.stanleyReisnerIdeal k ↔ ∀ α ∈ f.support, α.support ∉ K.faces := by
  rw [stanleyReisnerIdeal, MvPolynomial.mem_ideal_span_monomial_image]
  refine forall₂_congr fun α _ => ?_
  constructor
  · rintro ⟨β, ⟨F, hF, rfl⟩, hle⟩
    exact K.nonface_of_subset ((squarefreeExponent_le_iff F α).mp hle) hF
  · intro h
    exact ⟨squarefreeExponent α.support, ⟨α.support, h, rfl⟩,
      (squarefreeExponent_le_iff _ _).mpr (Finset.Subset.refl _)⟩

variable {k} [Nontrivial k]

/-- A monic monomial is in the Stanley–Reisner ideal iff its vertex support
is a nonface. This is blueprint node `thm:membership`. -/
theorem monomial_mem_stanleyReisnerIdeal_iff (α : V →₀ ℕ) :
    MvPolynomial.monomial α (1 : k) ∈ K.stanleyReisnerIdeal k ↔
      α.support ∉ K.faces := by
  classical
  rw [stanleyReisnerIdeal, MvPolynomial.mem_ideal_span_monomial_image]
  simp only [MvPolynomial.support_monomial, one_ne_zero, ↓reduceIte,
    Finset.mem_singleton, forall_eq]
  constructor
  · rintro ⟨β, ⟨F, hF, rfl⟩, hle⟩
    exact K.nonface_of_subset ((squarefreeExponent_le_iff F α).mp hle) hF
  · intro h
    exact ⟨squarefreeExponent α.support, ⟨α.support, h, rfl⟩,
      (squarefreeExponent_le_iff _ _).mpr (Finset.Subset.refl _)⟩

/-- The actual multivariate polynomial quotient defining the face ring. -/
abbrev FaceRing (R : Type v) [CommRing R] :=
  MvPolynomial V R ⧸ K.stanleyReisnerIdeal R

end Complex

/-- The fine weight recovers the original exponent vector. -/
theorem weight_fine_eq (V : Type*) (α : V →₀ ℕ) :
    Finsupp.weight (fun v : V => Finsupp.single v 1) α = α := by
  classical
  ext v
  simp [Finsupp.weight_apply]

/-- Constant unit weights give the usual total degree. -/
theorem weight_one_eq_sum (V : Type*) (α : V →₀ ℕ) :
    Finsupp.weight (fun _ : V => (1 : ℕ)) α = α.sum (fun _ e => e) := by
  rw [Finsupp.weight_apply]
  simp

namespace Complex

variable (K : Complex V)

/-- Exponents indexing the standard monomials: their vertex supports are faces.
The zero exponent belongs, even if the empty face is the only face. -/
def faceExponents : Set (V →₀ ℕ) := {α | α.support ∈ K.faces}

variable (k : Type v) [CommRing k]

/-- As a coefficient submodule, the independently defined Stanley–Reisner ideal
consists of the polynomials supported on nonface exponents. -/
theorem stanleyReisnerIdeal_restrictScalars_eq_restrictSupport :
    (K.stanleyReisnerIdeal k).restrictScalars k =
      MvPolynomial.restrictSupport k K.faceExponentsᶜ := by
  ext f
  exact K.mem_stanleyReisnerIdeal_iff k f

/-- The nonface ideal and the face-supported polynomial submodule are complements. -/
theorem isCompl_stanleyReisnerIdeal_faceSupport :
    IsCompl ((K.stanleyReisnerIdeal k).restrictScalars k)
      (MvPolynomial.restrictSupport k K.faceExponents) := by
  rw [K.stanleyReisnerIdeal_restrictScalars_eq_restrictSupport,
    MvPolynomial.restrictSupport_eq_span, MvPolynomial.restrictSupport_eq_span]
  exact (MvPolynomial.basisMonomials V k).linearIndependent.isCompl_span_image
    (MvPolynomial.basisMonomials V k).span_eq isCompl_compl.symm

/-- The classes of face-supported monic monomials form a basis of the actual
face-ring quotient. No finiteness or field hypothesis is needed. -/
noncomputable def faceRingBasis : Module.Basis K.faceExponents k (K.FaceRing k) :=
  (MvPolynomial.basisRestrictSupport k K.faceExponents).map
    ((K.stanleyReisnerIdeal k).restrictScalars k |>.quotientEquivOfIsCompl
      (MvPolynomial.restrictSupport k K.faceExponents)
      (K.isCompl_stanleyReisnerIdeal_faceSupport k)).symm

/-- Each standard basis vector is the quotient class of its stated monomial. -/
@[simp]
theorem faceRingBasis_apply (α : K.faceExponents) :
    K.faceRingBasis k α =
      Ideal.Quotient.mk (K.stanleyReisnerIdeal k) (MvPolynomial.monomial α.1 1) := by
  change Ideal.Quotient.mk (K.stanleyReisnerIdeal k)
    ((MvPolynomial.basisRestrictSupport k K.faceExponents α).1) = _
  congr 1
  change AddMonoidAlgebra.ofCoeff
    ((Finsupp.supportedEquivFinsupp (R := k) K.faceExponents).symm
      (Finsupp.single α 1)).1 = _
  simp only [Finsupp.supportedEquivFinsupp_symm_single]
  rfl

/-- Constants embed in the face ring: no nonzero coefficient is killed by
the nonface ideal. This holds over every commutative coefficient ring. -/
theorem faceRing_algebraMap_injective :
    Function.Injective (algebraMap k (K.FaceRing k)) := by
  classical
  apply (injective_iff_map_eq_zero _).mpr
  intro c hc
  change Ideal.Quotient.mk (K.stanleyReisnerIdeal k) (MvPolynomial.C c) = 0 at hc
  have hmem := Ideal.Quotient.eq_zero_iff_mem.mp hc
  by_contra hne
  have hzero : (0 : V →₀ ℕ) ∈ (MvPolynomial.C c).support := by
    simpa only [MvPolynomial.mem_support_iff, MvPolynomial.coeff_C, ↓reduceIte]
      using hne
  exact (K.mem_stanleyReisnerIdeal_iff k _).mp hmem 0 hzero
    (by simpa using K.empty_mem)

end Complex

namespace Complex

variable (K : Complex V) (k : Type v) [CommRing k] [Nontrivial k]

/-- The empty-face monomial survives, so the face ring is nontrivial, including
for a complex with no actual vertices. -/
instance faceRing_nontrivial : Nontrivial (K.FaceRing k) := by
  apply Ideal.Quotient.nontrivial_iff.mpr
  intro h
  have hmem : MvPolynomial.monomial 0 (1 : k) ∈ K.stanleyReisnerIdeal k := by
    rw [h]
    trivial
  exact ((K.monomial_mem_stanleyReisnerIdeal_iff 0).mp hmem) (by simpa using K.empty_mem)

end Complex

namespace Complex

variable (K : Complex V)

/-- The degree-`d` component of the face ring for a weight on the variables.
It is the image of the supported coordinate submodule under the inverse
coordinate map of the standard monomial basis. -/
noncomputable def weightedFaceRingComponent (R : Type v) [CommRing R]
    {M : Type*} [AddCommMonoid M] (w : V → M) (d : M) :
    Submodule R (K.FaceRing R) :=
  (Finsupp.supported R R {a : K.faceExponents | Finsupp.weight w a.1 = d}).map
    (K.faceRingBasis R).repr.symm.toLinearMap

/-- The weighted component is the span of the standard basis vectors in its
degree fiber. -/
theorem weightedFaceRingComponent_eq_span (R : Type v) [CommRing R]
    {M : Type*} [AddCommMonoid M] (w : V → M) (d : M) :
    K.weightedFaceRingComponent R w d =
      Submodule.span R
        (Set.range fun a : {a : K.faceExponents // Finsupp.weight w a.1 = d} =>
          K.faceRingBasis R a.1) := by
  classical
  rw [weightedFaceRingComponent, Finsupp.supported_eq_span_single, Submodule.map_span]
  congr 1
  ext x
  simp

/-- A monomial whose exponent support is a nonface vanishes in the face
ring. This also holds when the coefficient ring is trivial. -/
theorem monomial_nonface_eq_zero (R : Type v) [CommRing R] (a : V →₀ ℕ)
    (ha : a.support ∉ K.faces) :
    Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.monomial a (1 : R)) = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  apply (K.mem_stanleyReisnerIdeal_iff R _).mpr
  intro b hb
  have hba : b = a := Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset hb)
  simpa [hba] using ha

/-- The quotient component is the image of the matching polynomial
weighted-homogeneous submodule. -/
theorem weightedFaceRingComponent_eq_polynomial_image (R : Type v) [CommRing R]
    {M : Type*} [AddCommMonoid M] (w : V → M) (d : M) :
    K.weightedFaceRingComponent R w d =
      (MvPolynomial.weightedHomogeneousSubmodule R w d).map
        (Ideal.Quotient.mkₐ R (K.stanleyReisnerIdeal R)).toLinearMap := by
  classical
  have hpoly : MvPolynomial.weightedHomogeneousSubmodule R w d =
      Submodule.span R ((fun a => MvPolynomial.monomial a (1:R)) ''
        {a | Finsupp.weight w a = d}) := by
    rw [MvPolynomial.weightedHomogeneousSubmodule_eq_finsupp_supported]
    exact MvPolynomial.restrictSupport_eq_span R _
  rw [weightedFaceRingComponent_eq_span, hpoly, Submodule.map_span, Set.image_image]
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro x ⟨a, rfl⟩
    apply Submodule.subset_span
    exact ⟨a.1.1, a.2, by simp [K.faceRingBasis_apply R a.1]⟩
  · refine Submodule.span_le.mpr ?_
    rintro x ⟨a, ha, rfl⟩
    by_cases hface : a.support ∈ K.faces
    · have hm : K.faceRingBasis R ⟨a, hface⟩ ∈ Submodule.span R
          (Set.range fun a : {a : K.faceExponents // Finsupp.weight w a.1 = d} =>
            K.faceRingBasis R a.1) :=
        Submodule.subset_span ⟨⟨⟨a,hface⟩,ha⟩,rfl⟩
      change Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.monomial a 1) ∈ _
      exact (K.faceRingBasis_apply R ⟨a,hface⟩) ▸ hm
    · change Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.monomial a 1) ∈ _
      rw [K.monomial_nonface_eq_zero R a hface]
      exact Submodule.zero_mem _

/-- Multiplication adds weighted degrees on the quotient components. -/
theorem weightedFaceRingComponent_mul (R : Type v) [CommRing R]
    {M : Type*} [AddCommMonoid M] (w : V → M) (d e : M) :
    K.weightedFaceRingComponent R w d * K.weightedFaceRingComponent R w e ≤
      K.weightedFaceRingComponent R w (d + e) := by
  rw [weightedFaceRingComponent_eq_polynomial_image,
    weightedFaceRingComponent_eq_polynomial_image,
    weightedFaceRingComponent_eq_polynomial_image, ← Submodule.map_mul]
  exact Submodule.map_mono (MvPolynomial.weightedHomogeneousSubmodule_mul w d e)

/-- The weighted components form an internal direct sum. -/
theorem weightedFaceRing_isInternal (R : Type v) [CommRing R]
    {M : Type*} [AddCommMonoid M] (w : V → M) :
    letI : DecidableEq M := Classical.decEq M
    DirectSum.IsInternal (K.weightedFaceRingComponent R w) := by
  classical
  let _ : DecidableEq M := Classical.decEq M
  let b := K.faceRingBasis R
  let δ : K.faceExponents → M := fun a => Finsupp.weight w a.1
  let P : M → Submodule R (K.FaceRing R) := K.weightedFaceRingComponent R w
  change DirectSum.IsInternal P
  apply DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
  · apply LinearMap.iSupIndep_map _ b.repr.symm.injective
    rw [iSupIndep_def]
    intro d
    have hd := Finsupp.disjoint_supported_supported (M := R) (R := R)
      (s := {a : K.faceExponents | δ a = d})
      (t := {a : K.faceExponents | δ a = d}ᶜ) disjoint_compl_right
    apply hd.mono_right
    refine iSup₂_le fun e he => Finsupp.supported_mono ?_
    intro a ha
    exact fun h => he (ha.symm.trans h)
  · change (⨆ d, (Finsupp.supported R R {a : K.faceExponents | δ a = d}).map
        b.repr.symm.toLinearMap) = ⊤
    rw [← Submodule.map_iSup, ← Finsupp.supported_iUnion]
    have h : (⋃ d : M, {a : K.faceExponents | δ a = d}) = Set.univ := by
      ext a
      simp
    rw [h, Finsupp.supported_univ, Submodule.map_top]
    exact LinearMap.range_eq_top.mpr b.repr.symm.surjective

/-- The basis-fiber components carry a genuine internal graded-algebra
structure. -/
@[instance_reducible]
noncomputable def weightedFaceRingGradedAlgebra (R : Type v) [CommRing R]
    {M : Type*} [AddCommMonoid M] (w : V → M) :
    letI : DecidableEq M := Classical.decEq M
    GradedAlgebra (K.weightedFaceRingComponent R w) := by
  letI : DecidableEq M := Classical.decEq M
  let hD := (K.weightedFaceRing_isInternal R w).chooseDecomposition
  letI : SetLike.GradedMonoid (K.weightedFaceRingComponent R w) := {
    one_mem := by
      rw [weightedFaceRingComponent_eq_polynomial_image]
      apply Submodule.mem_map.mpr
      refine ⟨1, ?_, by simp⟩
      exact MvPolynomial.isWeightedHomogeneous_one R w
    mul_mem := by
      intro d e x y hx hy
      exact (K.weightedFaceRingComponent_mul R w d e) (Submodule.mul_mem_mul hx hy) }
  letI : DirectSum.Decomposition (K.weightedFaceRingComponent R w) := hD
  exact {}

/-- The fine component family on the face ring. -/
noncomputable def faceRingFineComponent (R : Type v) [CommRing R]
    (α : V →₀ ℕ) : Submodule R (K.FaceRing R) :=
  K.weightedFaceRingComponent R (fun v : V => Finsupp.single v 1) α

/-- The usual total-degree component family on the face ring. -/
noncomputable def faceRingTotalComponent (R : Type v) [CommRing R]
    (n : ℕ) : Submodule R (K.FaceRing R) :=
  K.weightedFaceRingComponent R (fun _ : V => (1 : ℕ)) n

/-- The fine grading of the face ring. -/
@[instance_reducible]
noncomputable def faceRingFineGradedAlgebra (R : Type v) [CommRing R] :
    letI : DecidableEq (V →₀ ℕ) := Classical.decEq _
    GradedAlgebra (K.faceRingFineComponent R) := by
  let _ : DecidableEq (V →₀ ℕ) := Classical.decEq _
  exact K.weightedFaceRingGradedAlgebra R (fun v : V => Finsupp.single v 1)

/-- The total-degree grading of the face ring. -/
@[instance_reducible]
noncomputable def faceRingTotalGradedAlgebra (R : Type v) [CommRing R] :
    letI : DecidableEq ℕ := Classical.decEq _
    GradedAlgebra (K.faceRingTotalComponent R) := by
  let _ : DecidableEq ℕ := Classical.decEq _
  exact K.weightedFaceRingGradedAlgebra R (fun _ : V => (1 : ℕ))

/-- Fine component α is the span of the class of its monomial. -/
theorem faceRingFineComponent_eq_span_monomial (R : Type v) [CommRing R]
    (a : V →₀ ℕ) :
    K.faceRingFineComponent R a = Submodule.span R
      {(Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.monomial a (1:R)))} := by
  classical
  change K.weightedFaceRingComponent R (fun v : V => Finsupp.single v 1) a = _
  rw [weightedFaceRingComponent_eq_polynomial_image,
    MvPolynomial.weightedHomogeneousSubmodule_eq_finsupp_supported]
  have hset : {b : V →₀ ℕ | Finsupp.weight (fun v : V => Finsupp.single v 1) b = a} = {a} := by
    ext b
    simp [Reisner.weight_fine_eq]
  rw [hset]
  change (MvPolynomial.restrictSupport R {a}).map _ = _
  rw [MvPolynomial.restrictSupport_eq_span, Set.image_singleton, Submodule.map_span,
    Set.image_singleton]
  rfl

/-- A nonface monomial has zero fine component in the quotient. -/
theorem faceRingFineComponent_eq_bot_of_nonface (R : Type v) [CommRing R]
    (a : V →₀ ℕ) (ha : a.support ∉ K.faces) : K.faceRingFineComponent R a = ⊥ := by
  rw [K.faceRingFineComponent_eq_span_monomial R a,
    K.monomial_nonface_eq_zero R a ha]
  simp

/-- Total degree n is spanned by standard monomials of total degree n. -/
theorem faceRingTotalComponent_eq_span (R : Type v) [CommRing R] (n : ℕ) :
    K.faceRingTotalComponent R n = Submodule.span R
      (Set.range fun a : {a : K.faceExponents // a.1.sum (fun _ e => e) = n} =>
        K.faceRingBasis R a.1) := by
  classical
  change K.weightedFaceRingComponent R (fun _ : V => (1:ℕ)) n = _
  rw [weightedFaceRingComponent_eq_span]
  congr 1
  ext x
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨⟨a.1, by simpa only [Reisner.weight_one_eq_sum] using a.2⟩, rfl⟩
  · rintro ⟨a, rfl⟩
    exact ⟨⟨a.1, by simpa only [Reisner.weight_one_eq_sum] using a.2⟩, rfl⟩

/-- The total-degree decomposition is the coarsening of the fine
decomposition by summing exponent coordinates. -/
theorem faceRingTotalComponent_eq_iSup_fine (R : Type v) [CommRing R] (n : ℕ) :
    K.faceRingTotalComponent R n =
      ⨆ (a : V →₀ ℕ) (_h : a.sum (fun _ e => e) = n), K.faceRingFineComponent R a := by
  classical
  change K.weightedFaceRingComponent R (fun _ : V => (1:ℕ)) n = _
  apply le_antisymm
  · rw [weightedFaceRingComponent_eq_span]
    refine Submodule.span_le.mpr ?_
    rintro x ⟨a, rfl⟩
    have ht : a.1.1.sum (fun _ e => e) = n := by
      simpa only [Reisner.weight_one_eq_sum] using a.2
    have hm : K.faceRingBasis R a.1 ∈ K.faceRingFineComponent R a.1.1 := by
      rw [K.faceRingFineComponent_eq_span_monomial R a.1.1]
      apply Submodule.subset_span
      exact K.faceRingBasis_apply R a.1
    exact Submodule.mem_iSup_of_mem a.1.1 (Submodule.mem_iSup_of_mem ht hm)
  · refine iSup₂_le fun a ha => ?_
    change K.weightedFaceRingComponent R (fun v : V => Finsupp.single v 1) a ≤
      K.weightedFaceRingComponent R (fun _ : V => (1:ℕ)) n
    rw [weightedFaceRingComponent_eq_span, weightedFaceRingComponent_eq_span]
    refine Submodule.span_le.mpr ?_
    rintro x ⟨b, rfl⟩
    have hb : b.1.1 = a := by simpa only [Reisner.weight_fine_eq] using b.2
    apply Submodule.subset_span
    exact ⟨⟨b.1, by simpa only [Reisner.weight_one_eq_sum, hb] using ha⟩, rfl⟩

/-- The fine degree-zero component consists of the scalar class of one. -/
theorem faceRingFineComponent_zero (R : Type v) [CommRing R] :
    K.faceRingFineComponent R 0 = Submodule.span R {(1 : K.FaceRing R)} := by
  rw [K.faceRingFineComponent_eq_span_monomial R 0]
  simp

/-- The total degree-zero component consists of the scalar class of one. -/
theorem faceRingTotalComponent_zero (R : Type v) [CommRing R] :
    K.faceRingTotalComponent R 0 = Submodule.span R {(1 : K.FaceRing R)} := by
  rw [K.faceRingTotalComponent_eq_iSup_fine R 0]
  apply le_antisymm
  · refine iSup₂_le fun a ha => ?_
    have ha0 : a = 0 := (Finsupp.degree_eq_zero_iff a).mp ha
    subst a
    exact le_of_eq (K.faceRingFineComponent_zero R)
  · rw [← K.faceRingFineComponent_zero R]
    exact le_iSup_of_le 0 (le_iSup_of_le (by simp) le_rfl)

/-- The degree-zero subalgebra in the total grading. -/
noncomputable def faceRingDegreeZeroSubalgebra (R : Type v) [CommRing R] :
    Subalgebra R (K.FaceRing R) := by
  letI : DecidableEq ℕ := Classical.decEq _
  letI := K.faceRingTotalGradedAlgebra R
  exact SetLike.GradeZero.subalgebra (K.faceRingTotalComponent R)

/-- Scalars identify the degree-zero subalgebra with the coefficient ring. -/
noncomputable def faceRingDegreeZeroEquiv (R : Type v) [CommRing R] :
    R ≃ₐ[R] K.faceRingDegreeZeroSubalgebra R := by
  let S := K.faceRingDegreeZeroSubalgebra R
  let f : R →ₐ[R] S := (Algebra.ofId R (K.FaceRing R)).codRestrict S
    (fun r => S.algebraMap_mem r)
  apply AlgEquiv.ofBijective f
  constructor
  · intro r s h
    apply K.faceRing_algebraMap_injective R
    exact congrArg Subtype.val h
  · intro y
    have hy : (y : K.FaceRing R) ∈ K.faceRingTotalComponent R 0 := by
      exact y.property
    rw [K.faceRingTotalComponent_zero R] at hy
    rcases Submodule.mem_span_singleton.mp hy with ⟨r, hr⟩
    refine ⟨r, ?_⟩
    apply Subtype.ext
    change algebraMap R (K.FaceRing R) r = (y : K.FaceRing R)
    rw [Algebra.algebraMap_eq_smul_one]
    exact hr

/-- The scalar equivalence evaluates to the algebra-map value. -/
@[simp]
theorem faceRingDegreeZeroEquiv_apply (R : Type v) [CommRing R] (r : R) :
    ((K.faceRingDegreeZeroEquiv R) r : K.FaceRing R) = algebraMap R (K.FaceRing R) r := rfl

end Complex

end Reisner

namespace Reisner

variable {V : Type u}

/-- The ideal generated by variables outside the finite coordinate set `F`. -/
noncomputable def coordinateIdeal (R : Type v) [CommSemiring R] (F : Finset V) :
    Ideal (MvPolynomial V R) :=
  Ideal.span (MvPolynomial.X '' {v : V | v ∉ F})

/-- Coordinate ideal membership is termwise: each exponent support contains
a vertex outside `F`. -/
theorem mem_coordinateIdeal_iff (R : Type v) [CommSemiring R] (F : Finset V)
    (p : MvPolynomial V R) :
    p ∈ coordinateIdeal R F ↔ ∀ a ∈ p.support, ¬ a.support ⊆ F := by
  classical
  rw [coordinateIdeal, MvPolynomial.mem_ideal_span_X_image]
  refine forall₂_congr fun a _ => ?_
  constructor
  · rintro ⟨v, hv, hne⟩ hsub
    exact hv (hsub (Finsupp.mem_support_iff.mpr hne))
  · intro h
    obtain ⟨v, hv, hF⟩ := Finset.not_subset.mp h
    exact ⟨v, hF, Finsupp.mem_support_iff.mp hv⟩

/-- Restrict variables to the subtype of vertices in `F`, killing all
variables outside it. -/
noncomputable def coordinateRestriction (R : Type v) [CommRing R] (F : Finset V) :
    MvPolynomial V R →ₐ[R] MvPolynomial {v : V // v ∈ F} R :=
  MvPolynomial.killCompl Subtype.val_injective

/-- The kernel of coordinate restriction is exactly the coordinate ideal. -/
theorem coordinateRestriction_ker (R : Type v) [CommRing R] (F : Finset V) :
    RingHom.ker (coordinateRestriction R F) = coordinateIdeal R F := by
  classical
  ext p
  rw [RingHom.mem_ker, mem_coordinateIdeal_iff]
  constructor
  · intro h a ha hsub
    let b : {v : V // v ∈ F} →₀ ℕ :=
      a.comapDomain Subtype.val Subtype.val_injective.injOn
    have hs : (a.support : Set V) ⊆ Set.range
        (Subtype.val : {v : V // v ∈ F} → V) := by
      intro v hv
      exact ⟨⟨v, hsub hv⟩, rfl⟩
    have hab : b.mapDomain Subtype.val = a :=
      a.mapDomain_comapDomain Subtype.val Subtype.val_injective hs
    have hc := congrArg (fun x : MvPolynomial {v : V // v ∈ F} R => x.coeff b) h
    change (MvPolynomial.killCompl Subtype.val_injective p).coeff b = _ at hc
    rw [MvPolynomial.coeff_killCompl, hab] at hc
    exact (MvPolynomial.mem_support_iff.mp ha) (by simpa using hc)
  · intro h
    ext b
    change (MvPolynomial.killCompl Subtype.val_injective p).coeff b = 0
    rw [MvPolynomial.coeff_killCompl]
    by_contra hn
    have hp : b.mapDomain Subtype.val ∈ p.support := MvPolynomial.mem_support_iff.mpr hn
    apply h _ hp
    intro v hv
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hv)
    exact u.property

/-- Coordinate restriction is surjective, by renaming the variables along
the subtype inclusion. -/
theorem coordinateRestriction_surjective (R : Type v) [CommRing R] (F : Finset V) :
    Function.Surjective (coordinateRestriction R F) := by
  intro p
  exact ⟨MvPolynomial.rename Subtype.val p,
    MvPolynomial.killCompl_rename_app _ p⟩

/-- The coordinate quotient is the polynomial ring on the retained vertices. -/
noncomputable def coordinateQuotientEquiv (R : Type v) [CommRing R] (F : Finset V) :
    (MvPolynomial V R ⧸ coordinateIdeal R F) ≃ₐ[R]
      MvPolynomial {v : V // v ∈ F} R :=
  (Ideal.quotientEquivAlgOfEq R (coordinateRestriction_ker R F).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (coordinateRestriction_surjective R F))

/-- The quotient equivalence is induced by coordinate restriction. -/
theorem coordinateQuotientEquiv_mk (R : Type v) [CommRing R] (F : Finset V)
    (p : MvPolynomial V R) :
    coordinateQuotientEquiv R F (Ideal.Quotient.mk (coordinateIdeal R F) p) =
      coordinateRestriction R F p := by
  simp [coordinateQuotientEquiv, Ideal.quotientEquivAlgOfEq_mk,
    Ideal.quotientKerAlgEquivOfSurjective_mk]

/-- Coordinate restriction preserves each variable indexed in `F`. -/
theorem coordinateRestriction_X_inside (R : Type v) [CommRing R] (F : Finset V)
    (v : {v : V // v ∈ F}) :
    coordinateRestriction R F (MvPolynomial.X v.1) = MvPolynomial.X v := by
  dsimp only [coordinateRestriction]
  have h := MvPolynomial.killCompl_rename_app (R := R)
    Subtype.val_injective (MvPolynomial.X v)
  simpa only [MvPolynomial.rename_X] using h

/-- Coordinate restriction kills variables indexed outside `F`. -/
theorem coordinateRestriction_X_outside (R : Type v) [CommRing R] (F : Finset V)
    (v : V) (hv : v ∉ F) : coordinateRestriction R F (MvPolynomial.X v) = 0 := by
  classical
  simp [coordinateRestriction, MvPolynomial.killCompl, hv]

/-- Every coordinate ideal is prime over a domain. -/
theorem coordinateIdeal_isPrime (R : Type v) [CommRing R] [IsDomain R] (F : Finset V) :
    (coordinateIdeal R F).IsPrime := by
  rw [← coordinateRestriction_ker R F]
  exact RingHom.ker_isPrime (coordinateRestriction R F)

/-- The coordinate quotient has dimension equal to the number of retained
vertices. -/
theorem coordinateQuotient_ringKrullDim (k : Type v) [Field k] (F : Finset V) :
    ringKrullDim (MvPolynomial V k ⧸ coordinateIdeal k F) =
      Nat.card {v : V // v ∈ F} := by
  classical
  rw [ringKrullDim_eq_of_ringEquiv (coordinateQuotientEquiv k F).toRingEquiv]
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite]
  rw [ringKrullDim_eq_zero_of_field, zero_add]

end Reisner

namespace Reisner

namespace Complex

variable {V : Type u} (K : Complex V)

/-- The set of inclusion-maximal faces. -/
def facets : Set (Finset V) :=
  {F | Maximal (fun G : Finset V => G ∈ K.faces) F}

/-- A finite ambient vertex type has only finitely many facets. -/
instance facets_finite [Finite V] : Finite (K.facets) := by
  let _ := Fintype.ofFinite V
  infer_instance

/-- Every face extends to a facet when the ambient type is finite. -/
theorem exists_facet_superset [Finite V] {F : Finset V} (hF : F ∈ K.faces) :
    ∃ G : K.facets, F ⊆ G.1 := by
  let _ := Fintype.ofFinite V
  obtain ⟨G, hFG, hG⟩ := Finite.exists_le_maximal
    (p := fun G : Finset V => G ∈ K.faces) hF
  exact ⟨⟨G, hG⟩, hFG⟩

/-- Every complex has at least one facet on a finite ambient set. -/
theorem facets_nonempty [Finite V] : Nonempty K.facets := by
  obtain ⟨G, _⟩ := K.exists_facet_superset K.empty_mem
  exact ⟨G⟩

/-- The Stanley–Reisner ideal is the intersection of coordinate ideals over
the facets. -/
theorem stanleyReisnerIdeal_eq_iInf_coordinateIdeal [Finite V]
    (R : Type v) [CommSemiring R] :
    K.stanleyReisnerIdeal R = ⨅ F : K.facets, coordinateIdeal R F.1 := by
  ext p
  rw [K.mem_stanleyReisnerIdeal_iff R p, Ideal.mem_iInf]
  simp_rw [mem_coordinateIdeal_iff]
  constructor
  · intro h G a ha hsub
    exact h a ha (K.face_of_subset hsub G.2.1)
  · intro h a ha hface
    obtain ⟨G, hsub⟩ := K.exists_facet_superset hface
    exact h G a ha hsub

/-- Every prime containing the Stanley–Reisner ideal contains one of its
facet coordinate ideals. -/
theorem exists_facet_coordinateIdeal_le [Finite V] (R : Type v) [CommSemiring R]
    (Q : Ideal (MvPolynomial V R)) (hQ : Q.IsPrime)
    (hIQ : K.stanleyReisnerIdeal R ≤ Q) :
    ∃ F : K.facets, coordinateIdeal R F.1 ≤ Q := by
  rw [K.stanleyReisnerIdeal_eq_iInf_coordinateIdeal R] at hIQ
  classical
  let _ := Fintype.ofFinite V
  have hfin : Finset.univ.inf (fun F : K.facets => coordinateIdeal R F.1) ≤ Q := by
    simpa [Finset.inf_eq_iInf] using hIQ
  obtain ⟨F, _, hF⟩ := hQ.inf_le'.mp hfin
  exact ⟨F, hF⟩

/-- Ghost ambient vertices lie outside every facet. -/
theorem ghost_not_mem_facet (F : K.facets) (v : V)
    (hv : ({v} : Finset V) ∉ K.faces) : v ∉ F.1 := by
  intro h
  exact hv (K.face_of_subset (Finset.singleton_subset_iff.mpr h) F.2.1)

/-- If every ambient vertex is a ghost, the empty face is the unique facet. -/
theorem facets_eq_singleton_empty_of_no_vertices
    (hV : ∀ v : V, ({v} : Finset V) ∉ K.faces) : K.facets = {∅} := by
  have hempty : ∀ (F : Finset V), F ∈ K.faces → F = ∅ := by
    intro F hF
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro v hv
    exact hV v (K.face_of_subset (Finset.singleton_subset_iff.mpr hv) hF)
  ext F
  constructor
  · intro h
    exact Set.mem_singleton_iff.mpr (hempty F h.1)
  · intro h
    obtain rfl := Set.mem_singleton_iff.mp h
    refine ⟨K.empty_mem, ?_⟩
    intro G hG _
    simp [hempty G hG]

variable (R : Type v) [CommRing R]

def faceRingConstantCoeffHom : MvPolynomial V R →ₐ[R] R where
  toRingHom := MvPolynomial.constantCoeff
  commutes' := by
    intro r
    exact MvPolynomial.constantCoeff_C V r

theorem faceRingConstantCoeff_vanishes_on_ideal
    {p : MvPolynomial V R} (hp : p ∈ K.stanleyReisnerIdeal R) :
    faceRingConstantCoeffHom R p = 0 := by
  change p.coeff 0 = 0
  by_contra hn
  have hs : (0 : V →₀ ℕ) ∈ p.support := MvPolynomial.mem_support_iff.mpr hn
  exact (K.mem_stanleyReisnerIdeal_iff R p).mp hp 0 hs (by simpa using K.empty_mem)

/-- Evaluation at zero descends to the actual Stanley–Reisner quotient. -/
noncomputable def faceRingAugmentation : K.FaceRing R →ₐ[R] R :=
  Ideal.Quotient.liftₐ (K.stanleyReisnerIdeal R) (faceRingConstantCoeffHom R)
    (fun _ hp => faceRingConstantCoeff_vanishes_on_ideal K R hp)

/-- The augmentation of a quotient class is its polynomial constant term. -/
@[simp]
theorem faceRingAugmentation_mk (p : MvPolynomial V R) :
    K.faceRingAugmentation R (Ideal.Quotient.mk (K.stanleyReisnerIdeal R) p) =
      p.constantCoeff := rfl

/-- The augmentation is the identity on coefficient scalars. -/
@[simp]
theorem faceRingAugmentation_algebraMap (r : R) :
    K.faceRingAugmentation R (algebraMap R (K.FaceRing R) r) = r :=
  (K.faceRingAugmentation R).commutes r

/-- The augmentation is surjective, since it fixes every scalar. -/
theorem faceRingAugmentation_surjective : Function.Surjective (K.faceRingAugmentation R) := by
  intro r
  exact ⟨algebraMap R (K.FaceRing R) r, K.faceRingAugmentation_algebraMap R r⟩

/-- The augmentation ideal is the ideal generated by all variable classes. -/
noncomputable def faceRingAugmentationIdeal : Ideal (K.FaceRing R) :=
  Ideal.span (Set.range fun v : V =>
    Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X v))

/-- The positive-degree ideal is generated by all positive total-degree
components. -/
noncomputable def faceRingPositiveIdeal : Ideal (K.FaceRing R) :=
  Ideal.span {a | ∃ n : ℕ, 0 < n ∧ a ∈ K.faceRingTotalComponent R n}

/-- In the polynomial ring, vanishing constant coefficient is membership
in the variable ideal. -/
theorem idealOfVars_eq_ker_constantCoeff :
    MvPolynomial.idealOfVars V R = RingHom.ker (faceRingConstantCoeffHom R) := by
  ext p
  rw [← pow_one (MvPolynomial.idealOfVars V R), MvPolynomial.mem_pow_idealOfVars_iff']
  simp only [RingHom.mem_ker]
  change (∀ x : V →₀ ℕ, Finsupp.degree x < 1 → p.coeff x = 0) ↔ p.coeff 0 = 0
  constructor
  · intro h
    exact h 0 (by simp)
  · intro h x hx
    have hx0 : x = 0 := (Finsupp.degree_eq_zero_iff x).mp (Nat.lt_one_iff.mp hx)
    simpa [hx0] using h

/-- The augmentation ideal is the image of the polynomial variable ideal. -/
theorem faceRingAugmentationIdeal_eq_map_idealOfVars :
    K.faceRingAugmentationIdeal R = (MvPolynomial.idealOfVars V R).map
      (Ideal.Quotient.mk (K.stanleyReisnerIdeal R)) := by
  rw [faceRingAugmentationIdeal, MvPolynomial.idealOfVars, Ideal.map_span,
    ← Set.range_comp]
  rfl

/-- The kernel of evaluation at zero is the augmentation ideal. -/
theorem faceRingAugmentation_ker :
    RingHom.ker (K.faceRingAugmentation R) = K.faceRingAugmentationIdeal R := by
  rw [faceRingAugmentationIdeal_eq_map_idealOfVars, idealOfVars_eq_ker_constantCoeff]
  ext a
  constructor
  · intro ha
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
    apply Ideal.mem_map_of_mem
    exact ha
  · intro ha
    obtain ⟨p, hp, rfl⟩ := (Ideal.mem_map_iff_of_surjective
      (Ideal.Quotient.mk (K.stanleyReisnerIdeal R)) Ideal.Quotient.mk_surjective).mp ha
    exact hp

/-- The quotient by the augmentation ideal is algebra-equivalent to the
coefficient ring. -/
noncomputable def faceRingResidueEquiv :
    (K.FaceRing R ⧸ K.faceRingAugmentationIdeal R) ≃ₐ[R] R :=
  (Ideal.quotientEquivAlgOfEq R (K.faceRingAugmentation_ker R).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (K.faceRingAugmentation_surjective R))

/-- The residue equivalence sends a quotient class to its augmentation. -/
theorem faceRingResidueEquiv_mk (a : K.FaceRing R) :
    K.faceRingResidueEquiv R (Ideal.Quotient.mk (K.faceRingAugmentationIdeal R) a) =
      K.faceRingAugmentation R a := by
  simp [faceRingResidueEquiv, Ideal.quotientEquivAlgOfEq_mk,
    Ideal.quotientKerAlgEquivOfSurjective_mk]

/-- Over a finite ambient type, the face ring is a finite-type algebra. -/
theorem faceRing_finiteType [Finite V] : Algebra.FiniteType R (K.FaceRing R) := by
  infer_instance

/-- Over a finite ambient type and a Noetherian coefficient ring, the face
ring is Noetherian. -/
theorem faceRing_isNoetherianRing [Finite V] [IsNoetherianRing R] :
    IsNoetherianRing (K.FaceRing R) :=
  Algebra.FiniteType.isNoetherianRing R (K.FaceRing R)

/-- The augmentation ideal is the positive-total-degree ideal. -/
theorem faceRingAugmentationIdeal_eq_positive :
    K.faceRingAugmentationIdeal R = K.faceRingPositiveIdeal R := by
  apply le_antisymm
  · rw [faceRingAugmentationIdeal, Ideal.span_le]
    rintro a ⟨v, rfl⟩
    apply Ideal.subset_span
    refine ⟨1, by norm_num, ?_⟩
    change _ ∈ K.weightedFaceRingComponent R (fun _ : V => (1:ℕ)) 1
    rw [K.weightedFaceRingComponent_eq_polynomial_image]
    exact Submodule.mem_map.mpr ⟨MvPolynomial.X v,
      MvPolynomial.isWeightedHomogeneous_X R (fun _ : V => (1:ℕ)) v, rfl⟩
  · rw [faceRingPositiveIdeal, Ideal.span_le]
    rintro a ⟨n, hn, ha⟩
    have hzero : K.faceRingAugmentation R a = 0 := by
      change a ∈ K.weightedFaceRingComponent R (fun _ : V => (1:ℕ)) n at ha
      rw [K.weightedFaceRingComponent_eq_polynomial_image] at ha
      obtain ⟨p, hp, rfl⟩ := ha
      change p.coeff 0 = 0
      exact MvPolynomial.IsWeightedHomogeneous.coeff_eq_zero hp 0
        (by simpa using ne_of_lt hn)
    rw [← K.faceRingAugmentation_ker R]
    exact hzero

/-- Ghost variables have zero class in the face ring. -/
theorem faceRing_variable_eq_zero_of_ghost (v : V)
    (hv : ({v} : Finset V) ∉ K.faces) :
    Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X v) = 0 := by
  classical
  simpa [MvPolynomial.X] using
    K.monomial_nonface_eq_zero R (Finsupp.single v 1) (by simpa using hv)

/-- Removing ghost variables from the generating set leaves the
augmentation ideal unchanged. -/
theorem faceRingAugmentationIdeal_eq_span_vertices :
    K.faceRingAugmentationIdeal R = Ideal.span (Set.range fun v :
      {v : V // ({v} : Finset V) ∈ K.faces} =>
        Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X v.1)) := by
  classical
  apply le_antisymm
  · rw [faceRingAugmentationIdeal, Ideal.span_le]
    rintro a ⟨v, rfl⟩
    change Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X v) ∈ _
    by_cases hv : ({v} : Finset V) ∈ K.faces
    · exact Ideal.subset_span ⟨⟨v, hv⟩, rfl⟩
    · rw [K.faceRing_variable_eq_zero_of_ghost R v hv]
      exact Ideal.zero_mem _
  · rw [Ideal.span_le]
    rintro a ⟨v, rfl⟩
    exact Ideal.subset_span ⟨v.1, rfl⟩

/-- If every ambient vertex is a ghost, the augmentation ideal is zero. -/
theorem faceRingAugmentationIdeal_eq_bot_of_no_vertices
    (hV : ∀ v : V, ({v} : Finset V) ∉ K.faces) :
    K.faceRingAugmentationIdeal R = ⊥ := by
  apply le_antisymm
  · rw [faceRingAugmentationIdeal, Ideal.span_le]
    rintro a ⟨v, rfl⟩
    change Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X v) ∈
      (⊥ : Ideal (K.FaceRing R))
    rw [K.faceRing_variable_eq_zero_of_ghost R v (hV v)]
    exact Ideal.zero_mem _
  · exact bot_le

/-- When only the empty face occurs, augmentation is an algebra
equivalence with the coefficient ring. -/
noncomputable def faceRingAugmentationEquivOfNoVertices
    (hV : ∀ v : V, ({v} : Finset V) ∉ K.faces) : K.FaceRing R ≃ₐ[R] R := by
  apply AlgEquiv.ofBijective (K.faceRingAugmentation R)
  refine ⟨?_, K.faceRingAugmentation_surjective R⟩
  apply (RingHom.injective_iff_ker_eq_bot (K.faceRingAugmentation R)).mpr
  rw [K.faceRingAugmentation_ker, K.faceRingAugmentationIdeal_eq_bot_of_no_vertices R hV]

/-- The no-vertices equivalence is the augmentation map. -/
@[simp]
theorem faceRingAugmentationEquivOfNoVertices_apply
    (hV : ∀ v : V, ({v} : Finset V) ∉ K.faces) (a : K.FaceRing R) :
    K.faceRingAugmentationEquivOfNoVertices R hV a = K.faceRingAugmentation R a := rfl

/-- The augmentation ideal is homogeneous for the total-degree grading. -/
theorem faceRingAugmentationIdeal_isHomogeneous :
    letI : DecidableEq ℕ := Classical.decEq ℕ
    letI := K.faceRingTotalGradedAlgebra R
    (K.faceRingAugmentationIdeal R).IsHomogeneous (K.faceRingTotalComponent R) := by
  classical
  let _ : DecidableEq ℕ := Classical.decEq ℕ
  let _ := K.faceRingTotalGradedAlgebra R
  rw [K.faceRingAugmentationIdeal_eq_positive R, faceRingPositiveIdeal]
  apply Ideal.homogeneous_span
  intro a ha
  rcases ha with ⟨n, hn, han⟩
  exact ⟨n, han⟩

/-- The augmentation ideal is maximal over a field. -/
theorem faceRingAugmentationIdeal_isMaximal (k : Type v) [Field k] :
    (K.faceRingAugmentationIdeal k).IsMaximal := by
  rw [← K.faceRingAugmentation_ker k]
  exact RingHom.ker_isMaximal_of_surjective (K.faceRingAugmentation k)
    (K.faceRingAugmentation_surjective k)

end Complex

end Reisner

namespace Reisner

variable {V : Type u}

/-- A variable lies in a coordinate ideal exactly when its vertex is killed. -/
@[simp]
theorem X_mem_coordinateIdeal_iff (R : Type v) [CommSemiring R] [Nontrivial R]
    (F : Finset V) (v : V) :
    MvPolynomial.X v ∈ coordinateIdeal R F ↔ v ∉ F := by
  classical
  simp [mem_coordinateIdeal_iff, MvPolynomial.X]

/-- Containment of coordinate ideals reverses containment of the retained vertex sets. -/
theorem coordinateIdeal_le_iff (R : Type v) [CommSemiring R] [Nontrivial R]
    (F G : Finset V) : coordinateIdeal R F ≤ coordinateIdeal R G ↔ G ⊆ F := by
  classical
  constructor
  · intro h v hv
    by_contra hvF
    exact (X_mem_coordinateIdeal_iff R G v).mp
      (h ((X_mem_coordinateIdeal_iff R F v).mpr hvF)) hv
  · intro h
    apply Ideal.span_mono
    exact Set.image_mono (fun v hv hvG => hv (h hvG))

/-- Killing every variable gives the usual polynomial variable ideal. -/
@[simp]
theorem coordinateIdeal_empty (R : Type v) [CommSemiring R] :
    coordinateIdeal R (∅ : Finset V) = MvPolynomial.idealOfVars V R := by
  classical
  simp [coordinateIdeal, MvPolynomial.idealOfVars]

/-- Removing the vertices of `F` one at a time gives a strict chain of coordinate
primes of length `F.card`, from `P_F` to the ideal of all variables.
This construction also works for infinite ambient types. -/
theorem exists_coordinatePrimeChain (k : Type v) [Field k] (F : Finset V) :
    ∃ p : LTSeries (PrimeSpectrum (MvPolynomial V k)),
      p.head.asIdeal = coordinateIdeal k F ∧
      p.last.asIdeal = coordinateIdeal k ∅ ∧ p.length = F.card := by
  classical
  induction F using Finset.induction_on with
  | empty =>
    exact ⟨RelSeries.singleton _ ⟨coordinateIdeal k ∅, coordinateIdeal_isPrime k ∅⟩,
      rfl, rfl, rfl⟩
  | @insert v F hv ih =>
    obtain ⟨p, hh, hl, hlen⟩ := ih
    have hlt : (⟨coordinateIdeal k (insert v F), coordinateIdeal_isPrime k _⟩ :
        PrimeSpectrum (MvPolynomial V k)) < p.head := by
      change coordinateIdeal k (insert v F) < p.head.asIdeal
      rw [hh, lt_iff_le_not_ge, coordinateIdeal_le_iff, coordinateIdeal_le_iff]
      exact ⟨Finset.subset_insert _ _, fun h => hv (h (Finset.mem_insert_self _ _))⟩
    refine ⟨p.cons _ hlt, rfl, ?_, ?_⟩
    · simpa using hl
    · simp [hlen, Finset.card_insert_of_notMem hv]

namespace Complex

variable (K : Complex V)

/-- The actual vertices of the complex; ambient ghost vertices are excluded. -/
def vertices : Set V := {v | ({v} : Finset V) ∈ K.faces}

/-- The maximum cardinality of a face on a finite ambient type. The empty face
guarantees that this maximum is attained, even when there are no actual vertices. -/
noncomputable def maxFaceCard [Finite V] : ℕ := by
  classical
  let _ := Fintype.ofFinite V
  exact Finset.univ.sup (fun F : K.faces => F.1.card)

/-- Every face has cardinality at most the maximum face cardinality. -/
theorem card_le_maxFaceCard [Finite V] {F : Finset V} (hF : F ∈ K.faces) :
    F.card ≤ K.maxFaceCard := by
  classical
  let _ := Fintype.ofFinite V
  exact Finset.le_sup (f := fun F : K.faces => F.1.card) (Finset.mem_univ ⟨F, hF⟩)

/-- The maximum face cardinality is attained by a face. -/
theorem exists_face_card_eq_maxFaceCard [Finite V] :
    ∃ F : Finset V, F ∈ K.faces ∧ F.card = K.maxFaceCard := by
  classical
  let _ := Fintype.ofFinite V
  obtain ⟨F, _, hF⟩ := Finset.exists_mem_eq_sup (Finset.univ : Finset K.faces)
    ⟨⟨∅, K.empty_mem⟩, Finset.mem_univ _⟩ (fun F => F.1.card)
  exact ⟨F.1, F.2, hF.symm⟩

/-- Some facet attains the maximum face cardinality; no purity assumption is needed. -/
theorem exists_facet_card_eq_maxFaceCard [Finite V] :
    ∃ F : K.facets, F.1.card = K.maxFaceCard := by
  obtain ⟨F, hF, hcard⟩ := K.exists_face_card_eq_maxFaceCard
  obtain ⟨G, hFG⟩ := K.exists_facet_superset hF
  refine ⟨G, le_antisymm (K.card_le_maxFaceCard G.2.1) ?_⟩
  rw [← hcard]
  exact Finset.card_le_card hFG

/-- The simplicial dimension, with integer value `-1` for the only-empty-face complex. -/
noncomputable def dimension [Finite V] : ℤ := (K.maxFaceCard : ℤ) - 1

/-- The maximum face cardinality is zero exactly when every ambient vertex is a ghost. -/
theorem maxFaceCard_eq_zero_iff_no_vertices [Finite V] :
    K.maxFaceCard = 0 ↔ ∀ v : V, ({v} : Finset V) ∉ K.faces := by
  constructor
  · intro h v hv
    have hbound := K.card_le_maxFaceCard hv
    simp [h] at hbound
  · intro h
    obtain ⟨F, hF, hcard⟩ := K.exists_face_card_eq_maxFaceCard
    have hzero : F = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro v hv
      exact h v (K.face_of_subset (Finset.singleton_subset_iff.mpr hv) hF)
    rw [← hcard, hzero]
    rfl

/-- The augmented dimension convention includes the only-empty-face complex. -/
theorem dimension_eq_neg_one_iff_no_vertices [Finite V] :
    K.dimension = -1 ↔ ∀ v : V, ({v} : Finset V) ∉ K.faces := by
  rw [← K.maxFaceCard_eq_zero_iff_no_vertices, dimension]
  omega

/-- Every face, not only every facet, determines a coordinate ideal containing
the Stanley–Reisner ideal. No finite-ambient hypothesis is needed. -/
theorem stanleyReisnerIdeal_le_coordinateIdeal (R : Type v) [CommSemiring R]
    {F : Finset V} (hF : F ∈ K.faces) :
    K.stanleyReisnerIdeal R ≤ coordinateIdeal R F := by
  intro p hp
  apply (mem_coordinateIdeal_iff R F p).mpr
  intro a ha hsub
  exact (K.mem_stanleyReisnerIdeal_iff R p).mp hp a ha (K.face_of_subset hsub hF)

/-- The global upper dimension bound. The first prime of a chain contains
a facet coordinate ideal, so the entire chain lies over that ideal and its
length is bounded by the corresponding polynomial quotient dimension. -/
theorem faceRing_ringKrullDim_le [Finite V] (k : Type v) [Field k] :
    ringKrullDim (K.FaceRing k) ≤ K.maxFaceCard := by
  rw [ringKrullDim_quotient, Order.krullDim]
  apply iSup_le
  intro p
  obtain ⟨F, hF⟩ := K.exists_facet_coordinateIdeal_le k p.head.1.asIdeal
    p.head.1.isPrime p.head.2
  let q : LTSeries (PrimeSpectrum.zeroLocus (R := MvPolynomial V k)
      (coordinateIdeal k F.1)) :=
    LTSeries.mk p.length (fun i => ⟨(p i).1, hF.trans (p.head_le i)⟩)
      (fun _ _ hij => p.strictMono hij)
  have hlen : (p.length : WithBot ℕ∞) ≤
      ringKrullDim (MvPolynomial V k ⧸ coordinateIdeal k F.1) := by
    rw [ringKrullDim_quotient]
    exact Order.LTSeries.length_le_krullDim q
  apply hlen.trans
  rw [coordinateQuotient_ringKrullDim]
  simpa [Nat.card_eq_fintype_card] using
    (Nat.cast_le (α := WithBot ℕ∞)).mpr (K.card_le_maxFaceCard F.2.1)

/-- The coordinate chain of any face descends to a chain of the same length
in the actual face ring, ending at its augmentation ideal. -/
theorem exists_faceRingPrimeChain (k : Type v) [Field k]
    {F : Finset V} (hF : F ∈ K.faces) :
    ∃ p : LTSeries (PrimeSpectrum (K.FaceRing k)),
      p.last.asIdeal = K.faceRingAugmentationIdeal k ∧ p.length = F.card := by
  obtain ⟨p, hh, hl, hlen⟩ := exists_coordinatePrimeChain k F
  let q : LTSeries (PrimeSpectrum.zeroLocus (R := MvPolynomial V k)
      (K.stanleyReisnerIdeal k)) :=
    LTSeries.mk p.length (fun i => ⟨p i,
      (K.stanleyReisnerIdeal_le_coordinateIdeal k hF).trans
        (hh ▸ p.head_le i)⟩) (fun _ _ hij => p.strictMono hij)
  let e := (K.stanleyReisnerIdeal k).primeSpectrumQuotientOrderIsoZeroLocus.symm
  refine ⟨q.map e e.strictMono, ?_, hlen⟩
  change p.last.asIdeal.map (Ideal.Quotient.mk (K.stanleyReisnerIdeal k)) = _
  rw [hl, coordinateIdeal_empty, K.faceRingAugmentationIdeal_eq_map_idealOfVars k]

/-- Every face supplies a lower bound for the height of the augmentation ideal. -/
theorem card_le_faceRingAugmentationIdeal_height (k : Type v) [Field k]
    {F : Finset V} (hF : F ∈ K.faces) :
    (F.card : ℕ∞) ≤ (K.faceRingAugmentationIdeal k).height := by
  obtain ⟨p, hl, hlen⟩ := K.exists_faceRingPrimeChain k hF
  rw [← hl, PrimeSpectrum.height_eq_orderHeight, ← hlen]
  exact Order.length_le_height_last

/-- A largest face supplies the sharp lower bound at the augmentation ideal. -/
theorem maxFaceCard_le_faceRingAugmentationIdeal_height [Finite V]
    (k : Type v) [Field k] :
    (K.maxFaceCard : ℕ∞) ≤ (K.faceRingAugmentationIdeal k).height := by
  obtain ⟨F, hF, hcard⟩ := K.exists_face_card_eq_maxFaceCard
  rw [← hcard]
  exact K.card_le_faceRingAugmentationIdeal_height k hF

/-- Over a field the augmentation ideal is prime, since it is maximal. -/
instance faceRingAugmentationIdeal_isPrime (k : Type v) [Field k] :
    (K.faceRingAugmentationIdeal k).IsPrime :=
  (K.faceRingAugmentationIdeal_isMaximal k).isPrime

/-- The face ring has Krull dimension equal to the maximum face cardinality. -/
theorem faceRing_ringKrullDim [Finite V] (k : Type v) [Field k] :
    ringKrullDim (K.FaceRing k) = K.maxFaceCard := by
  apply le_antisymm (K.faceRing_ringKrullDim_le k)
  exact (WithBot.coe_le_coe.mpr (K.maxFaceCard_le_faceRingAugmentationIdeal_height k)).trans
    Ideal.height_le_ringKrullDim_of_isPrime

/-- The augmentation ideal has height equal to the maximum face cardinality. -/
theorem faceRingAugmentationIdeal_height [Finite V] (k : Type v) [Field k] :
    (K.faceRingAugmentationIdeal k).height = K.maxFaceCard := by
  apply le_antisymm ?_ (K.maxFaceCard_le_faceRingAugmentationIdeal_height k)
  apply WithBot.coe_le_coe.mp
  exact Ideal.height_le_ringKrullDim_of_isPrime.trans (K.faceRing_ringKrullDim_le k)

/-- Localization at the augmentation ideal has the same dimension as the face ring.
Together with `faceRing_ringKrullDim` and the finite-type, Noetherian, and
residue-algebra results, this proves blueprint node `prop:dimension`. -/
theorem faceRing_atAugmentation_ringKrullDim [Finite V] (k : Type v) [Field k] :
    ringKrullDim (Localization.AtPrime (K.faceRingAugmentationIdeal k)) =
      K.maxFaceCard := by
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height (K.faceRingAugmentationIdeal k)
      (Localization.AtPrime (K.faceRingAugmentationIdeal k)),
    K.faceRingAugmentationIdeal_height k]
  rfl

end Complex
end Reisner

namespace Reisner.Complex

open scoped Classical

variable {V : Type u} (K : Reisner.Complex V) (R : Type v) [CommRing R]

/-- The actual face-ring class of the product of the variables in `F`. -/
noncomputable def faceRingFaceProduct (F : Finset V) : K.FaceRing R :=
  ∏ v ∈ F, Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.X v)

/-- The product of the variable classes is the class of the squarefree monomial. -/
theorem faceRingFaceProduct_eq_monomial (F : Finset V) :
    K.faceRingFaceProduct R F = Ideal.Quotient.mk (K.stanleyReisnerIdeal R)
      (MvPolynomial.monomial (Reisner.squarefreeExponent F) 1) := by
  rw [Reisner.monomial_squarefreeExponent_eq_prod, map_prod]
  rfl

/-- The empty product used for the degree-zero Cech term is one. -/
@[simp]
theorem faceRingFaceProduct_empty : K.faceRingFaceProduct R ∅ = 1 := by
  simp [faceRingFaceProduct]

/-- A subset product divides the product on the larger finite set. -/
theorem faceRingFaceProduct_dvd {F G : Finset V} (h : F ⊆ G) :
    K.faceRingFaceProduct R F ∣ K.faceRingFaceProduct R G := by
  classical
  exact Finset.prod_dvd_prod_of_subset F G _ h

/-- The complementary product gives an explicit factor for nested finite sets. -/
theorem faceRingFaceProduct_sdiff {F G : Finset V} (h : F ⊆ G) :
    K.faceRingFaceProduct R (G \ F) * K.faceRingFaceProduct R F =
      K.faceRingFaceProduct R G :=
  Finset.prod_sdiff h

/-- The actual ring localization at the powers of the finite variable product.
Nonfaces are allowed: inverting their zero product yields the zero ring. -/
abbrev FaceRingLocalization (F : Finset V) :=
  Localization.Away (K.faceRingFaceProduct R F)

/-- The fraction with the given polynomial numerator and variable-product denominator power. -/
noncomputable def faceRingLocalizationFraction (F : Finset V)
    (p : MvPolynomial V R) (r : ℕ) : K.FaceRingLocalization R F :=
  IsLocalization.mk' _ (Ideal.Quotient.mk (K.stanleyReisnerIdeal R) p)
    (Submonoid.pow (K.faceRingFaceProduct R F) r)

/-- Denominator power zero recovers the ordinary localization image. -/
@[simp]
theorem faceRingLocalizationFraction_zero_power (F : Finset V) (p : MvPolynomial V R) :
    K.faceRingLocalizationFraction R F p 0 =
      algebraMap (K.FaceRing R) (K.FaceRingLocalization R F)
        (Ideal.Quotient.mk (K.stanleyReisnerIdeal R) p) := by
  rw [faceRingLocalizationFraction, IsLocalization.mk'_eq_iff_eq_mul]
  simp [Submonoid.pow_apply]

/-- Every localization element has a polynomial numerator and a natural denominator power. -/
theorem faceRingLocalizationFraction_surjective (F : Finset V)
    (z : K.FaceRingLocalization R F) :
    ∃ (p : MvPolynomial V R) (r : ℕ), K.faceRingLocalizationFraction R F p r = z := by
  obtain ⟨a, ⟨_, r, rfl⟩, h⟩ := IsLocalization.exists_mk'_eq
    (Submonoid.powers (K.faceRingFaceProduct R F)) z
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  exact ⟨p, r, h⟩

/-- Multiplication by a monic monomial shifts each exponent without changing its coefficient.
Ideal membership is detected by the union of the two vertex supports. -/
theorem monomial_mul_mem_stanleyReisnerIdeal_iff (a : V →₀ ℕ)
    (p : MvPolynomial V R) :
    MvPolynomial.monomial a 1 * p ∈ K.stanleyReisnerIdeal R ↔
      ∀ b ∈ p.support, a.support ∪ b.support ∉ K.faces := by
  classical
  have hs : (MvPolynomial.monomial a 1 * p).support = p.support.map (addLeftEmbedding a) :=
    AddMonoidAlgebra.support_coeff_single_mul p 1 (by simp) a
  simp [K.mem_stanleyReisnerIdeal_iff, hs, Finsupp.support_add_eq_union]

/-- Multiplication by a variable-product power shifts the polynomial exponents. -/
theorem faceRingFaceProduct_pow_mul_mk (F : Finset V) (n : ℕ)
    (p : MvPolynomial V R) :
    K.faceRingFaceProduct R F ^ n * Ideal.Quotient.mk (K.stanleyReisnerIdeal R) p =
      Ideal.Quotient.mk (K.stanleyReisnerIdeal R)
        (MvPolynomial.monomial (n • Reisner.squarefreeExponent F) 1 * p) := by
  rw [K.faceRingFaceProduct_eq_monomial R F, ← map_pow, ← map_mul,
    MvPolynomial.monomial_pow, one_pow]

/-- One variable-product factor kills a polynomial class exactly when every
term support, joined with the inverted set, is a nonface. -/
theorem faceRingFaceProduct_mul_mk_eq_zero_iff (F : Finset V)
    (p : MvPolynomial V R) :
    K.faceRingFaceProduct R F * Ideal.Quotient.mk (K.stanleyReisnerIdeal R) p = 0 ↔
      ∀ a ∈ p.support, F ∪ a.support ∉ K.faces := by
  have h := K.faceRingFaceProduct_pow_mul_mk R F 1 p
  rw [pow_one, one_nsmul] at h
  rw [h, Ideal.Quotient.eq_zero_iff_mem, K.monomial_mul_mem_stanleyReisnerIdeal_iff,
    Reisner.support_squarefreeExponent]

/-- The exact kernel of the localization map, term by term on arbitrary polynomials.
Squarefree nonface relations imply that one product factor suffices. -/
theorem faceRingLocalization_algebraMap_mk_eq_zero_iff (F : Finset V)
    (p : MvPolynomial V R) :
    algebraMap (K.FaceRing R) (K.FaceRingLocalization R F)
        (Ideal.Quotient.mk (K.stanleyReisnerIdeal R) p) = 0 ↔
      ∀ a ∈ p.support, F ∪ a.support ∉ K.faces := by
  rw [IsLocalization.map_eq_zero_iff (Submonoid.powers (K.faceRingFaceProduct R F))]
  constructor
  · rintro ⟨⟨_, n, rfl⟩, hn⟩
    rw [K.faceRingFaceProduct_pow_mul_mk, Ideal.Quotient.eq_zero_iff_mem,
      K.monomial_mul_mem_stanleyReisnerIdeal_iff] at hn
    intro a ha
    have hs : (n • Reisner.squarefreeExponent F).support ⊆ F := by
      simpa only [Reisner.support_squarefreeExponent] using
        (Finsupp.support_smul (b := n) (g := Reisner.squarefreeExponent F))
    exact K.nonface_of_subset (Finset.union_subset_union hs (Finset.Subset.refl _)) (hn a ha)
  · intro h
    exact ⟨⟨K.faceRingFaceProduct R F, Submonoid.mem_powers _⟩,
      (K.faceRingFaceProduct_mul_mk_eq_zero_iff R F p).mpr h⟩

/-- The localization kernel is already killed by the first power of the variable product. -/
theorem faceRingLocalization_algebraMap_eq_zero_iff (F : Finset V) (a : K.FaceRing R) :
    algebraMap (K.FaceRing R) (K.FaceRingLocalization R F) a = 0 ↔
      K.faceRingFaceProduct R F * a = 0 := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [K.faceRingLocalization_algebraMap_mk_eq_zero_iff,
    K.faceRingFaceProduct_mul_mk_eq_zero_iff]

/-- The exact vanishing criterion for every polynomial fraction, independent
of its denominator power. This is the main kernel assertion of
blueprint node `lem:localization-kernel`. -/
theorem faceRingLocalizationFraction_eq_zero_iff (F : Finset V)
    (p : MvPolynomial V R) (r : ℕ) :
    K.faceRingLocalizationFraction R F p r = 0 ↔
      ∀ a ∈ p.support, F ∪ a.support ∉ K.faces := by
  rw [faceRingLocalizationFraction, IsLocalization.mk'_eq_iff_eq_mul, zero_mul,
    K.faceRingLocalization_algebraMap_mk_eq_zero_iff]

/-- A monic monomial fraction survives exactly when its numerator support
joined with the inverted vertex set is a face. -/
theorem faceRingLocalization_monomialFraction_ne_zero_iff [Nontrivial R]
    (F : Finset V) (a : V →₀ ℕ) (r : ℕ) :
    K.faceRingLocalizationFraction R F (MvPolynomial.monomial a 1) r ≠ 0 ↔
      F ∪ a.support ∈ K.faces := by
  classical
  simp [ne_eq, K.faceRingLocalizationFraction_eq_zero_iff, MvPolynomial.support_monomial]

/-- Over nontrivial coefficients, precisely the faces give nonzero localizations. -/
theorem faceRingLocalization_nontrivial_iff [Nontrivial R] (F : Finset V) :
    Nontrivial (K.FaceRingLocalization R F) ↔ F ∈ K.faces := by
  constructor
  · intro h
    let _ := h
    have hne : K.faceRingLocalizationFraction R F (MvPolynomial.monomial 0 1) 0 ≠ 0 := by
      simp
    simpa using (K.faceRingLocalization_monomialFraction_ne_zero_iff R F 0 0).mp hne
  · intro hF
    apply nontrivial_of_ne (K.faceRingLocalizationFraction R F (MvPolynomial.monomial 0 1) 0) 0
    apply (K.faceRingLocalization_monomialFraction_ne_zero_iff R F 0 0).mpr
    simpa using hF

/-- Inverting a nonface product gives the zero ring, including at ghost vertices. -/
theorem faceRingLocalization_subsingleton_of_nonface {F : Finset V} (hF : F ∉ K.faces) :
    Subsingleton (K.FaceRingLocalization R F) := by
  apply IsLocalization.subsingleton (M := Submonoid.powers (K.faceRingFaceProduct R F))
  have hz : K.faceRingFaceProduct R F = 0 := by
    rw [K.faceRingFaceProduct_eq_monomial]
    exact K.monomial_nonface_eq_zero R _ (by simpa using hF)
  exact ⟨1, by simp [hz]⟩

/-- When the inverted set is a face, the coefficient ring still embeds in the localization. -/
theorem faceRingLocalization_scalarMap_injective {F : Finset V} (hF : F ∈ K.faces) :
    Function.Injective (algebraMap R (K.FaceRingLocalization R F)) := by
  apply (injective_iff_map_eq_zero _).mpr
  intro c hc
  change algebraMap (K.FaceRing R) (K.FaceRingLocalization R F)
    (Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.C c)) = 0 at hc
  by_contra hn
  have hs : (0 : V →₀ ℕ) ∈ (MvPolynomial.C c).support := by
    simpa only [MvPolynomial.mem_support_iff, MvPolynomial.coeff_C, ↓reduceIte] using hn
  have hnot := (K.faceRingLocalization_algebraMap_mk_eq_zero_iff R F _).mp hc 0 hs
  exact hnot (by simpa using hF)

/-- The localization at the empty product is the original face ring, as a coefficient algebra. -/
noncomputable def faceRingLocalizationEmptyEquiv :
    K.FaceRing R ≃ₐ[R] K.FaceRingLocalization R ∅ :=
  (IsLocalization.atUnit (K.FaceRing R) (K.FaceRingLocalization R ∅)
    (K.faceRingFaceProduct R ∅) (by simp)).restrictScalars R

/-- The empty-product equivalence is the canonical localization map. -/
theorem faceRingLocalizationEmptyEquiv_apply (a : K.FaceRing R) :
    K.faceRingLocalizationEmptyEquiv R a =
      algebraMap (K.FaceRing R) (K.FaceRingLocalization R ∅) a := rfl

/-- The canonical coefficient-algebra map for nested inverted vertex sets. -/
noncomputable def faceRingLocalizationMap {F G : Finset V} (h : F ⊆ G) :
    K.FaceRingLocalization R F →ₐ[R] K.FaceRingLocalization R G :=
  IsLocalization.Away.liftAlgHom (K.faceRingFaceProduct R F)
    (f := Algebra.algHom R (K.FaceRing R) (K.FaceRingLocalization R G))
    (IsLocalization.Away.isUnit_of_dvd (K.faceRingFaceProduct R G)
      (K.faceRingFaceProduct_dvd R h))

/-- A transition map preserves the image of every element of the face ring. -/
@[simp]
theorem faceRingLocalizationMap_algebraMap {F G : Finset V} (h : F ⊆ G) (a : K.FaceRing R) :
    K.faceRingLocalizationMap R h
        (algebraMap (K.FaceRing R) (K.FaceRingLocalization R F) a) =
      algebraMap (K.FaceRing R) (K.FaceRingLocalization R G) a := by
  dsimp only [faceRingLocalizationMap, IsLocalization.Away.liftAlgHom]
  exact IsLocalization.Away.lift_eq (S := K.FaceRingLocalization R F)
    (g := (Algebra.algHom R (K.FaceRing R) (K.FaceRingLocalization R G)).toRingHom)
    (K.faceRingFaceProduct R F)
    (IsLocalization.Away.isUnit_of_dvd (K.faceRingFaceProduct R G)
      (K.faceRingFaceProduct_dvd R h)) a

/-- Normalize the same fraction in the larger localization by multiplying
the numerator by the complementary variable-product power. -/
theorem faceRingLocalizationMap_fraction {F G : Finset V} (h : F ⊆ G)
    (p : MvPolynomial V R) (r : ℕ) :
    K.faceRingLocalizationMap R h (K.faceRingLocalizationFraction R F p r) =
      IsLocalization.mk' (K.FaceRingLocalization R G)
        (K.faceRingFaceProduct R (G \ F) ^ r *
          Ideal.Quotient.mk (K.stanleyReisnerIdeal R) p)
        (Submonoid.pow (K.faceRingFaceProduct R G) r) := by
  have hs : K.faceRingLocalizationMap R h (K.faceRingLocalizationFraction R F p r) *
      algebraMap (K.FaceRing R) (K.FaceRingLocalization R G)
        (K.faceRingFaceProduct R F ^ r) =
      algebraMap (K.FaceRing R) (K.FaceRingLocalization R G)
        (Ideal.Quotient.mk (K.stanleyReisnerIdeal R) p) := by
    have hsF : K.faceRingLocalizationFraction R F p r *
        algebraMap (K.FaceRing R) (K.FaceRingLocalization R F)
          (K.faceRingFaceProduct R F ^ r) =
        algebraMap (K.FaceRing R) (K.FaceRingLocalization R F)
          (Ideal.Quotient.mk (K.stanleyReisnerIdeal R) p) :=
      IsLocalization.mk'_spec (K.FaceRingLocalization R F)
        (Ideal.Quotient.mk (K.stanleyReisnerIdeal R) p)
        (Submonoid.pow (K.faceRingFaceProduct R F) r)
    simpa only [map_mul, K.faceRingLocalizationMap_algebraMap] using
      congrArg (K.faceRingLocalizationMap R h) hsF
  rw [IsLocalization.eq_mk'_iff_mul_eq]
  change _ * algebraMap (K.FaceRing R) (K.FaceRingLocalization R G)
    (K.faceRingFaceProduct R G ^ r) = _
  have hp : K.faceRingFaceProduct R G ^ r =
      K.faceRingFaceProduct R (G \ F) ^ r * K.faceRingFaceProduct R F ^ r := by
    rw [← K.faceRingFaceProduct_sdiff R h, mul_pow]
  rw [hp, map_mul, map_mul]
  rw [mul_left_comm, hs]

/-- The transition map for an identical inverted set is the identity. -/
theorem faceRingLocalizationMap_self (F : Finset V) :
    K.faceRingLocalizationMap R (Finset.Subset.refl F) = AlgHom.id R _ := by
  apply IsLocalization.algHom_ext (Submonoid.powers (K.faceRingFaceProduct R F))
  ext a
  change K.faceRingLocalizationMap R (Finset.Subset.refl F) (algebraMap _ _ a) =
    algebraMap _ _ a
  rw [K.faceRingLocalizationMap_algebraMap]

/-- Transition maps compose for three nested finite vertex sets. -/
theorem faceRingLocalizationMap_comp {F G H : Finset V} (hFG : F ⊆ G) (hGH : G ⊆ H) :
    (K.faceRingLocalizationMap R hGH).comp (K.faceRingLocalizationMap R hFG) =
      K.faceRingLocalizationMap R (hFG.trans hGH) := by
  apply IsLocalization.algHom_ext (Submonoid.powers (K.faceRingFaceProduct R F))
  ext a
  change K.faceRingLocalizationMap R hGH
    (K.faceRingLocalizationMap R hFG (algebraMap _ _ a)) =
      K.faceRingLocalizationMap R (hFG.trans hGH) (algebraMap _ _ a)
  simp only [K.faceRingLocalizationMap_algebraMap]

end Reisner.Complex

namespace Reisner.Complex

open scoped Classical
open Finset

variable {V : Type u} (K : Complex V) (R : Type v) [CommRing R]

/-- Regard a natural exponent vector as an integer exponent vector. -/
noncomputable def natExponent (b : V →₀ ℕ) : V →₀ ℤ := b.mapRange Int.ofNat rfl

@[simp]
theorem natExponent_apply (b : V →₀ ℕ) (v : V) :
    natExponent b v = b v := rfl

/-- The positive support of an integer exponent vector. -/
def positiveSupport (a : V →₀ ℤ) : Finset V :=
  a.support.filter fun v => 0 < a v

/-- Admissible degrees in the localization at the product on `F`. -/
def LocalizationAdmissible (F : Finset V) (a : V →₀ ℤ) : Prop :=
  (∀ v ∉ F, 0 ≤ a v) ∧ F ∪ positiveSupport a ∈ K.faces

/-- The multidegree of a monomial numerator divided by the indicated product power. -/
noncomputable def fractionDegree (F : Finset V) (b : V →₀ ℕ) (r : ℕ) : V →₀ ℤ :=
  natExponent b - r • natExponent (squarefreeExponent F)

private noncomputable def shiftedExponent (F : Finset V) (a : V →₀ ℤ) (r : ℕ) : V →₀ ℕ :=
  (a + r • natExponent (squarefreeExponent F)).mapRange Int.toNat rfl

/-- The fraction degree is the numerator exponent minus the denominator exponent. -/
theorem fractionDegree_apply (F : Finset V) (b : V →₀ ℕ) (r : ℕ) (v : V) :
    fractionDegree F b r v = (b v : ℤ) - (r : ℤ) * (if v ∈ F then 1 else 0) := by
  by_cases h : v ∈ F <;> simp [fractionDegree, squarefreeExponent_apply,
    Finsupp.sub_apply, Finsupp.nsmul_apply, h]

private theorem shiftedExponent_apply (F : Finset V) (a : V →₀ ℤ) (r : ℕ) (v : V) :
    shiftedExponent F a r v = (a v + (r : ℤ) * (if v ∈ F then 1 else 0)).toNat := by
  by_cases h : v ∈ F <;> simp [shiftedExponent, squarefreeExponent_apply,
    Finsupp.add_apply, Finsupp.nsmul_apply, h]

private theorem fractionDegree_shifted (F : Finset V) (a : V →₀ ℤ) (r : ℕ)
    (hr : ∀ v, 0 ≤ a v + (r : ℤ) * (if v ∈ F then 1 else 0)) :
    fractionDegree F (shiftedExponent F a r) r = a := by
  ext v
  rw [fractionDegree_apply, shiftedExponent_apply, Int.toNat_of_nonneg (hr v)]
  omega

private theorem fractionDegree_injective (F : Finset V) (r : ℕ) :
    Function.Injective (fun b => fractionDegree F b r) := by
  intro b c h
  ext v
  have e := DFunLike.congr_fun h v
  simp only [fractionDegree_apply] at e
  omega

private theorem fractionDegree_add_shift (F : Finset V) (b : V →₀ ℕ) (r n : ℕ) :
    fractionDegree F (n • squarefreeExponent F + b) (r + n) = fractionDegree F b r := by
  ext v
  simp only [fractionDegree_apply, Finsupp.add_apply, Finsupp.nsmul_apply,
    nsmul_eq_mul, squarefreeExponent_apply]
  split <;> simp
  omega

private theorem localizationAdmissible_fractionDegree (F : Finset V) (b : V →₀ ℕ) (r : ℕ) :
    K.LocalizationAdmissible F (fractionDegree F b r) ↔ F ∪ b.support ∈ K.faces := by
  have ho : ∀ v ∉ F, fractionDegree F b r v = b v := by
    intro v hv
    simp [fractionDegree_apply, hv]
  have he : F ∪ positiveSupport (fractionDegree F b r) = F ∪ b.support := by
    ext v
    by_cases hv : v ∈ F
    · simp [hv]
    · simp [hv, positiveSupport, Finsupp.mem_support_iff, ho v hv, Nat.pos_iff_ne_zero]
  have hn : ∀ v ∉ F, 0 ≤ fractionDegree F b r v := fun v hv => by rw [ho v hv]; positivity
  rw [LocalizationAdmissible, he]
  exact ⟨And.right, fun h => ⟨hn, h⟩⟩

private def denominatorBound (F : Finset V) (a : V →₀ ℤ) : ℕ :=
  F.sup fun v => (a v).natAbs

private theorem shifted_nonneg (F : Finset V) (a : V →₀ ℤ)
    (ha : ∀ v ∉ F, 0 ≤ a v) (r : ℕ) (hr : denominatorBound F a ≤ r) :
    ∀ v, 0 ≤ a v + (r : ℤ) * (if v ∈ F then 1 else 0) := by
  intro v
  by_cases hv : v ∈ F
  · have hb : (a v).natAbs ≤ r :=
      (Finset.le_sup (f := fun v => (a v).natAbs) hv).trans hr
    simp only [ite_eq_left hv, mul_one]
    omega
  · simpa [hv] using ha v hv

private noncomputable def fractionLinear (F : Finset V) (r : ℕ) :
    MvPolynomial V R →ₗ[R] K.FaceRingLocalization R F :=
  Algebra.lmul R _ (IsLocalization.mk' (K.FaceRingLocalization R F) 1
    (Submonoid.pow (K.faceRingFaceProduct R F) r)) ∘ₗ
    ((Algebra.algHom R (K.FaceRing R) (K.FaceRingLocalization R F)).comp
      (Ideal.Quotient.mkₐ R (K.stanleyReisnerIdeal R))).toLinearMap

private theorem fractionLinear_apply (F : Finset V) (r : ℕ) (p : MvPolynomial V R) :
    fractionLinear K R F r p = K.faceRingLocalizationFraction R F p r := by
  rw [faceRingLocalizationFraction, IsLocalization.mk'_eq_mul_mk'_one]
  exact mul_comm _ _

private theorem fraction_shift (F : Finset V) (b : V →₀ ℕ) (r n : ℕ) :
    K.faceRingLocalizationFraction R F (MvPolynomial.monomial b 1) r =
      K.faceRingLocalizationFraction R F
        (MvPolynomial.monomial (n • squarefreeExponent F + b) 1) (r + n) := by
  rw [faceRingLocalizationFraction, faceRingLocalizationFraction,
    IsLocalization.mk'_eq_iff_eq]
  change algebraMap _ (K.FaceRingLocalization R F)
      (K.faceRingFaceProduct R F ^ (r + n) * _) =
    algebraMap _ (K.FaceRingLocalization R F) (K.faceRingFaceProduct R F ^ r * _)
  rw [pow_add, mul_assoc, K.faceRingFaceProduct_pow_mul_mk R F n,
    MvPolynomial.monomial_mul_monomial, one_mul]

private theorem fraction_of_degree_eq (F : Finset V) {b c : V →₀ ℕ} {r s : ℕ}
    (h : fractionDegree F b r = fractionDegree F c s) :
    K.faceRingLocalizationFraction R F (MvPolynomial.monomial b 1) r =
      K.faceRingLocalizationFraction R F (MvPolynomial.monomial c 1) s := by
  rw [fraction_shift K R F b r s, fraction_shift K R F c s r, Nat.add_comm s r]
  congr 3
  apply fractionDegree_injective F (r + s)
  dsimp only
  rw [fractionDegree_add_shift, Nat.add_comm r s, fractionDegree_add_shift]
  exact h

/-- The Laurent monomial in the actual localization, extended by zero to degrees
with negative exponents outside the inverted set. -/
@[no_expose]
noncomputable def localizationMonomial (F : Finset V) (a : V →₀ ℤ) :
    K.FaceRingLocalization R F :=
  if ∀ v ∉ F, 0 ≤ a v then
    K.faceRingLocalizationFraction R F
      (MvPolynomial.monomial (shiftedExponent F a (denominatorBound F a)) 1)
      (denominatorBound F a)
  else 0

/-- Every monic monomial fraction equals the Laurent monomial indexed by its degree. -/
theorem localizationMonomial_fraction (F : Finset V) (b : V →₀ ℕ) (r : ℕ) :
    K.localizationMonomial R F (fractionDegree F b r) =
      K.faceRingLocalizationFraction R F (MvPolynomial.monomial b 1) r := by
  have hn : ∀ v ∉ F, 0 ≤ fractionDegree F b r v := by
    intro v hv
    simp [fractionDegree_apply, hv]
  rw [localizationMonomial, ite_eq_left hn]
  apply fraction_of_degree_eq
  exact fractionDegree_shifted _ _ _ (shifted_nonneg _ _ hn _ le_rfl)

private theorem localizationMonomial_at_bound (F : Finset V) (a : V →₀ ℤ)
    (ha : ∀ v ∉ F, 0 ≤ a v) (r : ℕ) (hr : denominatorBound F a ≤ r) :
    K.localizationMonomial R F a = K.faceRingLocalizationFraction R F
      (MvPolynomial.monomial (shiftedExponent F a r) 1) r := by
  rw [← localizationMonomial_fraction,
    fractionDegree_shifted _ _ _ (shifted_nonneg _ _ ha _ hr)]

theorem localizationMonomial_eq_zero_of_not_admissible (F : Finset V) (a : V →₀ ℤ)
    (h : ¬ K.LocalizationAdmissible F a) : K.localizationMonomial R F a = 0 := by
  by_cases ha : ∀ v ∉ F, 0 ≤ a v
  · rw [localizationMonomial_at_bound K R F a ha _ le_rfl,
      K.faceRingLocalizationFraction_eq_zero_iff]
    intro b hb
    have e := Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset hb)
    subst b
    intro hf
    apply h
    exact (fractionDegree_shifted _ _ _ (shifted_nonneg _ _ ha _ le_rfl)) ▸
      ((localizationAdmissible_fractionDegree K F _ _).mpr hf)
  · simp [localizationMonomial, ha]

/-- The multidegrees for which the localization has a Laurent monomial. -/
def localizationDegrees (F : Finset V) : Set (V →₀ ℤ) :=
  {a | K.LocalizationAdmissible F a}

private theorem localizationMonomial_li (F : Finset V) :
    LinearIndependent R (fun a : K.localizationDegrees F => K.localizationMonomial R F a.1) := by
  apply linearIndependent_iff'.mpr
  intro s c h i hi
  let r := s.sup fun a => denominatorBound F a.1
  let b : K.localizationDegrees F → (V →₀ ℕ) := fun a => shiftedExponent F a.1 r
  have hb (a) (ha : a ∈ s) : fractionDegree F (b a) r = a.1 :=
    fractionDegree_shifted _ _ _ (shifted_nonneg _ _ a.2.1 _ (Finset.le_sup (f := fun a => denominatorBound F a.1) ha))
  let p : MvPolynomial V R := ∑ a ∈ s, c a • MvPolynomial.monomial (b a) 1
  have hp : K.faceRingLocalizationFraction R F p r = 0 := by
    rw [← fractionLinear_apply, show p = ∑ a ∈ s, c a • MvPolynomial.monomial (b a) 1 from rfl,
      map_sum]
    simp_rw [map_smul, fractionLinear_apply]
    rw [← h]
    apply Finset.sum_congr rfl
    intro a ha
    rw [localizationMonomial_at_bound K R F a.1 a.2.1 r (Finset.le_sup (f := fun a => denominatorBound F a.1) ha)]
  have hc : p.coeff (b i) = c i := by
    simp only [p, MvPolynomial.coeff_sum, MvPolynomial.coeff_smul, smul_eq_mul]
    rw [Finset.sum_eq_single_of_mem i hi]
    · simp
    · intro j hj hji
      have hne : b j ≠ b i := by
        intro e
        apply hji
        exact Subtype.ext ((hb j hj).symm.trans ((congrArg (fun x => fractionDegree F x r) e).trans
          (hb i hi)))
      simp [MvPolynomial.coeff_monomial, hne]
  by_contra hne
  have hs : b i ∈ p.support := MvPolynomial.mem_support_iff.mpr (hc ▸ hne)
  have hf : F ∪ (b i).support ∈ K.faces := by
    apply (localizationAdmissible_fractionDegree K F (b i) r).mp
    rw [hb i hi]
    exact i.2
  exact (K.faceRingLocalizationFraction_eq_zero_iff R F p r).mp hp _ hs hf

private theorem localizationMonomial_span (F : Finset V) :
    Submodule.span R (Set.range fun a : K.localizationDegrees F =>
      K.localizationMonomial R F a.1) = ⊤ := by
  apply top_unique
  intro z _
  obtain ⟨p, r, rfl⟩ := K.faceRingLocalizationFraction_surjective R F z
  rw [← fractionLinear_apply, p.as_sum, map_sum]
  apply Submodule.sum_mem
  intro b _
  have hs : MvPolynomial.monomial b (p.coeff b) = p.coeff b • MvPolynomial.monomial b 1 := by
    rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
  rw [hs, map_smul, fractionLinear_apply,
    ← localizationMonomial_fraction]
  apply Submodule.smul_mem
  by_cases ha : K.LocalizationAdmissible F (fractionDegree F b r)
  · exact Submodule.subset_span ⟨⟨_, ha⟩, rfl⟩
  · rw [K.localizationMonomial_eq_zero_of_not_admissible R F _ ha]
    exact Submodule.zero_mem _

/-- The basis of the actual localization consists of its admissible Laurent monomials. -/
@[no_expose]
noncomputable def localizationMonomialBasis (F : Finset V) :
    Module.Basis (K.localizationDegrees F) R (K.FaceRingLocalization R F) :=
  Module.Basis.mk (localizationMonomial_li K R F) (localizationMonomial_span K R F).ge

@[simp]
theorem localizationMonomialBasis_apply (F : Finset V) (a : K.localizationDegrees F) :
    K.localizationMonomialBasis R F a = K.localizationMonomial R F a.1 :=
  Module.Basis.mk_apply _ _ _

/-- Over nontrivial coefficients, a Laurent monomial survives exactly in its admissible degree. -/
theorem localizationMonomial_ne_zero_iff [Nontrivial R] (F : Finset V) (a : V →₀ ℤ) :
    K.localizationMonomial R F a ≠ 0 ↔ K.LocalizationAdmissible F a := by
  by_cases ha : ∀ v ∉ F, 0 ≤ a v
  · rw [localizationMonomial_at_bound K R F a ha _ le_rfl,
      K.faceRingLocalization_monomialFraction_ne_zero_iff,
      ← localizationAdmissible_fractionDegree,
      fractionDegree_shifted _ _ _ (shifted_nonneg _ _ ha _ le_rfl)]
  · simp [localizationMonomial, LocalizationAdmissible, ha]

private theorem fraction_monomial_mul (F : Finset V) (b c : V →₀ ℕ) (r s : ℕ) :
    K.faceRingLocalizationFraction R F (MvPolynomial.monomial b 1) r *
      K.faceRingLocalizationFraction R F (MvPolynomial.monomial c 1) s =
        K.faceRingLocalizationFraction R F (MvPolynomial.monomial (b + c) 1) (r + s) := by
  have hden : Submonoid.pow (K.faceRingFaceProduct R F) r *
      Submonoid.pow (K.faceRingFaceProduct R F) s =
        Submonoid.pow (K.faceRingFaceProduct R F) (r+s) := by
    ext
    simp [Submonoid.pow_apply, pow_add]
  simp only [faceRingLocalizationFraction, ← IsLocalization.mk'_mul, hden, ← map_mul,
    MvPolynomial.monomial_mul_monomial, one_mul]

private theorem fractionDegree_mul (F : Finset V) (b c : V →₀ ℕ) (r s : ℕ) :
    fractionDegree F (b + c) (r + s) = fractionDegree F b r + fractionDegree F c s := by
  ext v
  simp only [fractionDegree_apply, Finsupp.add_apply, Nat.cast_add]
  split <;> simp
  omega

private theorem localizationMonomial_mul (F : Finset V) (a b : V →₀ ℤ)
    (ha : ∀ v ∉ F, 0 ≤ a v) (hb : ∀ v ∉ F, 0 ≤ b v) :
    K.localizationMonomial R F a * K.localizationMonomial R F b =
      K.localizationMonomial R F (a + b) := by
  let r := denominatorBound F a
  let s := denominatorBound F b
  rw [localizationMonomial_at_bound K R F a ha r le_rfl,
    localizationMonomial_at_bound K R F b hb s le_rfl, fraction_monomial_mul,
    ← localizationMonomial_fraction, fractionDegree_mul,
    fractionDegree_shifted _ _ _ (shifted_nonneg _ _ ha r le_rfl),
    fractionDegree_shifted _ _ _ (shifted_nonneg _ _ hb s le_rfl)]

@[simp]
theorem localizationMonomial_natExponent (F : Finset V) (b : V →₀ ℕ) :
    K.localizationMonomial R F (natExponent b) =
      algebraMap (K.FaceRing R) (K.FaceRingLocalization R F)
        (Ideal.Quotient.mk (K.stanleyReisnerIdeal R) (MvPolynomial.monomial b 1)) := by
  have h : fractionDegree F b 0 = natExponent b := by simp [fractionDegree]
  rw [← h, localizationMonomial_fraction, K.faceRingLocalizationFraction_zero_power]

private theorem localizationMonomial_zero (F : Finset V) :
    K.localizationMonomial R F 0 = 1 := by
  have h : natExponent (0 : V →₀ ℕ) = 0 := by ext; simp
  rw [← h, localizationMonomial_natExponent]
  simp

/-- The degree component is the span of the corresponding Laurent monomial. -/
noncomputable def faceRingLocalizationComponent (F : Finset V) (a : V →₀ ℤ) :
    Submodule R (K.FaceRingLocalization R F) :=
  Submodule.span R {K.localizationMonomial R F a}

/-- An inadmissible degree has zero homogeneous component. -/
theorem faceRingLocalizationComponent_eq_bot (F : Finset V) (a : V →₀ ℤ)
    (h : ¬ K.LocalizationAdmissible F a) : K.faceRingLocalizationComponent R F a = ⊥ := by
  simp [faceRingLocalizationComponent, K.localizationMonomial_eq_zero_of_not_admissible R F a h]

/-- Over a field, precisely the admissible degrees have dimension one. -/
theorem faceRingLocalizationComponent_finrank (k : Type*) [Field k]
    (F : Finset V) (a : V →₀ ℤ) :
    Module.finrank k (K.faceRingLocalizationComponent k F a) =
      if K.LocalizationAdmissible F a then 1 else 0 := by
  by_cases ha : K.LocalizationAdmissible F a
  · rw [ite_eq_left ha, faceRingLocalizationComponent,
      finrank_span_singleton ((K.localizationMonomial_ne_zero_iff k F a).mpr ha)]
  · rw [ite_eq_right ha, K.faceRingLocalizationComponent_eq_bot k F a ha, finrank_bot]

private theorem localizationComponent_eq_basisFiber (F : Finset V) (a : V →₀ ℤ) :
    K.faceRingLocalizationComponent R F a =
      (Finsupp.supported R R {b : K.localizationDegrees F | b.1 = a}).map
        (K.localizationMonomialBasis R F).repr.symm.toLinearMap := by
  rw [Finsupp.supported_eq_span_single, Submodule.map_span]
  simp only [Set.image_image, LinearEquiv.coe_coe, Module.Basis.repr_symm_single,
    one_smul, localizationMonomialBasis_apply]
  by_cases ha : K.LocalizationAdmissible F a
  · have hset : (fun b : K.localizationDegrees F => K.localizationMonomial R F b.1) ''
        {b | b.1 = a} = {K.localizationMonomial R F a} := by
      ext z
      constructor
      · rintro ⟨b, hb, rfl⟩
        simp [show b.1 = a from hb]
      · intro hz
        exact ⟨⟨a, ha⟩, rfl, (Set.mem_singleton_iff.mp hz).symm⟩
    rw [hset, faceRingLocalizationComponent]
  · rw [K.faceRingLocalizationComponent_eq_bot R F a ha]
    have hempty : {b : K.localizationDegrees F | b.1 = a} = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro b hb
      exact ha ((show b.1 = a from hb) ▸ b.2)
    simp [hempty]

/-- The integer degree components give an internal direct sum of the localization. -/
theorem faceRingLocalization_isInternal (F : Finset V) :
    DirectSum.IsInternal (K.faceRingLocalizationComponent R F) := by
  let b := K.localizationMonomialBasis R F
  have hcomp : K.faceRingLocalizationComponent R F = fun a =>
      (Finsupp.supported R R {x : K.localizationDegrees F | x.1 = a}).map
        b.repr.symm.toLinearMap :=
    funext (localizationComponent_eq_basisFiber K R F)
  rw [hcomp]
  apply DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
  ·
    apply LinearMap.iSupIndep_map _ b.repr.symm.injective
    rw [iSupIndep_def]
    intro a
    have hd := Finsupp.disjoint_supported_supported (M := R) (R := R)
      (s := {b : K.localizationDegrees F | b.1 = a})
      (t := {b : K.localizationDegrees F | b.1 = a}ᶜ) disjoint_compl_right
    apply hd.mono_right
    refine iSup₂_le fun e he => Finsupp.supported_mono ?_
    intro b hb
    exact fun h => he (hb.symm.trans h)
  · rw [← Submodule.map_iSup, ← Finsupp.supported_iUnion]
    have h : (⋃ a : V →₀ ℤ, {b : K.localizationDegrees F | b.1 = a}) = Set.univ := by
      ext a
      simp
    rw [h, Finsupp.supported_univ, Submodule.map_top]
    exact LinearMap.range_eq_top.mpr b.repr.symm.surjective

/-- The actual localization carries its integer multigrading as a graded algebra. -/
@[instance_reducible]
noncomputable def faceRingLocalizationGradedAlgebra (F : Finset V) :
    GradedAlgebra (K.faceRingLocalizationComponent R F) := by
  letI : DirectSum.Decomposition (K.faceRingLocalizationComponent R F) :=
    (K.faceRingLocalization_isInternal R F).chooseDecomposition
  letI : SetLike.GradedMonoid (K.faceRingLocalizationComponent R F) := {
    one_mem := by
      rw [← K.localizationMonomial_zero R F]
      exact Submodule.mem_span_singleton_self _
    mul_mem := by
      intro a b x y hx hy
      rcases Submodule.mem_span_singleton.mp hx with ⟨c, rfl⟩
      rcases Submodule.mem_span_singleton.mp hy with ⟨d, rfl⟩
      by_cases ha : K.LocalizationAdmissible F a
      · by_cases hb : K.LocalizationAdmissible F b
        · rw [smul_mul_smul_comm, K.localizationMonomial_mul R F a b ha.1 hb.1]
          exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
        · simp [K.localizationMonomial_eq_zero_of_not_admissible R F b hb]
      · simp [K.localizationMonomial_eq_zero_of_not_admissible R F a ha] }
  exact {}

private theorem fractionDegree_transition {F G : Finset V} (h : F ⊆ G)
    (b : V →₀ ℕ) (r : ℕ) :
    fractionDegree G (r • squarefreeExponent (G \ F) + b) r = fractionDegree F b r := by
  ext v
  by_cases hf : v ∈ F
  · simp [fractionDegree_apply, Finsupp.add_apply, Finsupp.nsmul_apply, squarefreeExponent_apply,
      hf, h hf]
  · by_cases hg : v ∈ G <;>
      simp [fractionDegree_apply, Finsupp.add_apply, Finsupp.nsmul_apply, squarefreeExponent_apply,
        hf, hg]

/-- A transition preserves the Laurent monomial in each degree with negative support in the
source's inverted set. In an inadmissible target degree, that monomial is zero. -/
theorem faceRingLocalizationMap_monomial {F G : Finset V} (h : F ⊆ G)
    (a : V →₀ ℤ) (ha : ∀ v ∉ F, 0 ≤ a v) :
    K.faceRingLocalizationMap R h (K.localizationMonomial R F a) =
      K.localizationMonomial R G a := by
  let r := denominatorBound F a
  rw [localizationMonomial_at_bound K R F a ha r le_rfl, K.faceRingLocalizationMap_fraction,
    K.faceRingFaceProduct_pow_mul_mk, MvPolynomial.monomial_mul_monomial, one_mul,
    ← faceRingLocalizationFraction, ← localizationMonomial_fraction,
    fractionDegree_transition h, fractionDegree_shifted _ _ _ (shifted_nonneg _ _ ha r le_rfl)]

/-- The canonical localization maps preserve every degree component. -/
theorem faceRingLocalizationMap_component {F G : Finset V} (h : F ⊆ G) (a : V →₀ ℤ) :
    (K.faceRingLocalizationComponent R F a).map (K.faceRingLocalizationMap R h).toLinearMap ≤
      K.faceRingLocalizationComponent R G a := by
  by_cases ha : K.LocalizationAdmissible F a
  · simp only [faceRingLocalizationComponent, Submodule.map_span, Set.image_singleton,
      AlgHom.toLinearMap_apply, K.faceRingLocalizationMap_monomial R h a ha.1, le_refl]
  · rw [K.faceRingLocalizationComponent_eq_bot R F a ha, Submodule.map_bot]
    exact bot_le

/-- Localization maps send the basis vector in a common admissible degree to the corresponding
basis vector. -/
theorem faceRingLocalizationMap_basis {F G : Finset V} (h : F ⊆ G)
    (a : V →₀ ℤ) (ha : K.LocalizationAdmissible F a) (hb : K.LocalizationAdmissible G a) :
    K.faceRingLocalizationMap R h (K.localizationMonomialBasis R F ⟨a, ha⟩) =
      K.localizationMonomialBasis R G ⟨a, hb⟩ := by
  simp only [localizationMonomialBasis_apply]
  exact K.faceRingLocalizationMap_monomial R h a ha.1

/-- Every monomial fraction belongs to the component indexed by its exponent shift. -/
theorem faceRingLocalizationFraction_mem_component (F : Finset V) (b : V →₀ ℕ) (r : ℕ) :
    K.faceRingLocalizationFraction R F (MvPolynomial.monomial b 1) r ∈
      K.faceRingLocalizationComponent R F (fractionDegree F b r) := by
  rw [← K.localizationMonomial_fraction R F b r]
  exact Submodule.mem_span_singleton_self _

/-- The basis of an admissible degree component has one vector, its Laurent monomial. -/
noncomputable def faceRingLocalizationComponentBasis (k : Type*) [Field k]
    (F : Finset V) (a : V →₀ ℤ) (ha : K.LocalizationAdmissible F a) :
    Module.Basis Unit k (K.faceRingLocalizationComponent k F a) := by
  let m : K.faceRingLocalizationComponent k F a :=
    ⟨K.localizationMonomial k F a, Submodule.mem_span_singleton_self _⟩
  refine Module.Basis.mk (v := fun _ : Unit => m) (linearIndependent_unique_iff.mpr ?_) ?_
  · intro hm
    exact ((K.localizationMonomial_ne_zero_iff k F a).mpr ha) (congrArg Subtype.val hm)
  · intro x _
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp x.property
    have hx : c • m = x := Subtype.ext hc
    rw [← hx]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self ()))

@[simp]
theorem faceRingLocalizationComponentBasis_apply (k : Type*) [Field k]
    (F : Finset V) (a : V →₀ ℤ) (ha : K.LocalizationAdmissible F a) :
    (K.faceRingLocalizationComponentBasis k F a ha () : K.FaceRingLocalization k F) =
      K.localizationMonomial k F a := by
  simp only [faceRingLocalizationComponentBasis, Module.Basis.mk_apply]

/-- A Laurent monomial in a source degree vanishes under transition if the target degree
is inadmissible. -/
theorem faceRingLocalizationMap_basis_eq_zero {F G : Finset V} (h : F ⊆ G)
    (a : V →₀ ℤ) (ha : K.LocalizationAdmissible F a) (hb : ¬ K.LocalizationAdmissible G a) :
    K.faceRingLocalizationMap R h (K.localizationMonomialBasis R F ⟨a, ha⟩) = 0 := by
  rw [localizationMonomialBasis_apply, K.faceRingLocalizationMap_monomial R h a ha.1,
    K.localizationMonomial_eq_zero_of_not_admissible R G a hb]

/-- The localization map sends a fine homogeneous piece onto the component
of the corresponding integer degree. -/
theorem faceRingFineComponent_map_localization (F : Finset V) (b : V →₀ ℕ) :
    (K.faceRingFineComponent R b).map
        (Algebra.algHom R (K.FaceRing R) (K.FaceRingLocalization R F)).toLinearMap =
      K.faceRingLocalizationComponent R F (natExponent b) := by
  rw [K.faceRingFineComponent_eq_span_monomial, Submodule.map_span, Set.image_singleton,
    faceRingLocalizationComponent, K.localizationMonomial_natExponent]
  rfl

end Reisner.Complex
